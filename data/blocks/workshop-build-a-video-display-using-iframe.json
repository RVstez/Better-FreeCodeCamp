{"name":"workshop-build-a-video-display-using-iframe","kind":"workshop","layout":"challenge-grid","multifile":true,"editableBoundaries":true,"helpCategory":"HTML-CSS","challenges":[{"id":"68b94f23f7b3ee14078c89c5","title":"Step 1","dashedName":"step-1","challengeType":0,"demoType":"onLoad","description":[{"t":"p","c":["In this workshop, you will use the ",{"t":"code","v":"iframe"}," element to display a video. The basic HTML boilerplate has been prepared for you."]},{"t":"p","c":["Begin by creating an ",{"t":"code","v":"h1"}," element with the text ",{"t":"code","v":"iframe Video Display"},"."]}],"hints":[{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"h1"}," element."]}],"test":"assert.exists(document.querySelector('h1'))"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"h1"}," element should have the text ",{"t":"code","v":"iframe Video Display"},"."]}],"test":"assert.equal(document.querySelector('h1')?.textContent.trim(), 'iframe Video Display')"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Display Videos in an iframe</title>\n  </head>\n  <body>\n    \n  </body>\n</html>","editable":[8,9]}]},"solutions":[],"step":1},{"id":"68ba9c4f1688914d72876093","title":"Step 2","dashedName":"step-2","challengeType":0,"description":[{"t":"p","c":["Now, create an ",{"t":"code","v":"iframe"}," element. Don't put anything in it yet."]}],"hints":[{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"iframe"}," element."]}],"test":"assert.exists(document.querySelector('iframe'))"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"iframe"}," element should be empty."]}],"test":"assert.equal(document.querySelector('iframe')?.innerHTML.trim(), '')"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Display Videos in an iframe</title>\n  </head>\n  <body>\n    <h1>iframe Video Display</h1>\n    \n  </body>\n</html>","editable":[9,10]}]},"solutions":[],"step":2},{"id":"68ba9c4f1688914d72876094","title":"Step 3","dashedName":"step-3","challengeType":0,"description":[{"t":"p","c":["In the first lesson on the ",{"t":"code","v":"iframe"}," element, you learned it's a replaced element just like ",{"t":"code","v":"img"},". That means it can also take the ",{"t":"code","v":"width"}," and ",{"t":"code","v":"height"}," attributes to determine how tall and wide it should be."]},{"t":"p","c":["Give your ",{"t":"code","v":"iframe"}," element a ",{"t":"code","v":"width"}," of ",{"t":"code","v":"560"}," and a ",{"t":"code","v":"height"}," of ",{"t":"code","v":"315"},"."]}],"hints":[{"text":[{"t":"p","c":["Your ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"width"}," attribute set to ",{"t":"code","v":"560"},"."]}],"test":"const iframeEl = document.querySelector('iframe')\nassert.equal(iframeEl?.getAttribute('width'), '560')"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"height"}," attribute set to ",{"t":"code","v":"315"},"."]}],"test":"const iframeEl = document.querySelector('iframe')\nassert.equal(iframeEl?.getAttribute('height'), '315')"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Display Videos in an iframe</title>\n  </head>\n  <body>\n    <h1>iframe Video Display</h1>\n\n    <iframe\n      \n    >\n\n    </iframe>\n  </body>\n</html>","editable":[11,12]}]},"solutions":[],"step":3},{"id":"68ba9c4f1688914d72876095","title":"Step 4","dashedName":"step-4","challengeType":0,"description":[{"t":"p","c":["The ",{"t":"code","v":"iframe"}," element also takes an ",{"t":"code","v":"src"}," attribute with a value that indicates the URL or the path of the resource to display."]},{"t":"p","c":["Add an ",{"t":"code","v":"src"}," attribute of ",{"t":"code","v":"https://www.youtube.com/embed/I0_951_MPE0"}," to your ",{"t":"code","v":"iframe"}," element."]},{"t":"p","c":["At this point, you should see the video displaying on the page, but there are some more attributes you need to add."]}],"hints":[{"text":[{"t":"p","c":["Your ",{"t":"code","v":"iframe"}," element should have an ",{"t":"code","v":"src"}," attribute set to ",{"t":"code","v":"https://www.youtube.com/embed/I0_951_MPE0"},"."]}],"test":"const iframeEl = document.querySelector('iframe')\nassert.equal(iframeEl?.getAttribute('src'), 'https://www.youtube.com/embed/I0_951_MPE0')"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Display Videos in an iframe</title>\n  </head>\n  <body>\n    <h1>iframe Video Display</h1>\n    <iframe\n      width=\"560\"\n      height=\"315\"\n      \n    >\n\n    </iframe>\n  </body>\n</html>","editable":[12,13]}]},"solutions":[],"step":4},{"id":"68ba9c4f1688914d72876096","title":"Step 5","dashedName":"step-5","challengeType":0,"description":[{"t":"p","c":["One of the attributes is ",{"t":"code","v":"allow"},". It's like a permission list that tells the browser what features the ",{"t":"code","v":"iframe"}," is allowed to use."]},{"t":"p","c":["Here's an ",{"t":"code","v":"iframe"}," element with the ",{"t":"code","v":"allow"}," attribute:"]},{"t":"code","lang":"html","text":"<iframe\n  allow=\"accelerometer autoplay clipboard-write encrypted-media gyroscope picture-in-picture web-share\"\n></iframe>"},{"t":"p","c":["Add the ",{"t":"code","v":"allow"}," attribute with the value ",{"t":"code","v":"accelerometer"},", ",{"t":"code","v":"autoplay"},", and ",{"t":"code","v":"clipboard-write"},"."]},{"t":"p","c":[{"t":"code","v":"accelerometer"}," lets the ",{"t":"code","v":"iframe"}," use motion sensors so it can detect things like device tilting and rotation. ",{"t":"code","v":"autoplay"}," lets the video start playing automatically, and ",{"t":"code","v":"clipboard-write"}," lets the ",{"t":"code","v":"iframe"}," write data to the user's clipboard."]}],"hints":[{"text":[{"t":"p","c":["Your ",{"t":"code","v":"iframe"}," element should have an ",{"t":"code","v":"allow"}," attribute set to ",{"t":"code","v":"accelerometer"},"."]}],"test":"const iframeEl = document.querySelector('iframe')\nconst iframeElAllowAttr = iframeEl?.getAttribute('allow')\nassert.match(iframeElAllowAttr, /accelerometer/)"},{"text":[{"t":"p","c":["The ",{"t":"code","v":"allow"}," attribute of your ",{"t":"code","v":"iframe"}," element should have ",{"t":"code","v":"autoplay"}," as one of its values."]}],"test":"const iframeEl = document.querySelector('iframe')\nconst iframeElAllowAttr = iframeEl?.getAttribute('allow')\nassert.match(iframeElAllowAttr, /autoplay/)"},{"text":[{"t":"p","c":["The ",{"t":"code","v":"allow"}," attribute of your ",{"t":"code","v":"iframe"}," element should have ",{"t":"code","v":"clipboard-write"}," as one of its values."]}],"test":"const iframeEl = document.querySelector('iframe')\nconst iframeElAllowAttr = iframeEl?.getAttribute('allow')\nassert.match(iframeElAllowAttr, /clipboard-write/)"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Display Videos in an iframe</title>\n  </head>\n  <body>\n    <h1>iframe Video Display</h1>\n    <iframe\n      width=\"560\"\n      height=\"315\"\n      src=\"https://www.youtube.com/embed/I0_951_MPE0\"\n      \n    >\n\n    </iframe>\n  </body>\n</html>","editable":[13,14]}]},"solutions":[],"step":5},{"id":"68ba9c4f1688914d72876097","title":"Step 6","dashedName":"step-6","challengeType":0,"description":[{"t":"p","c":["Add ",{"t":"code","v":"encrypted-media"},", ",{"t":"code","v":"gyroscope"},", and ",{"t":"code","v":"web-share"}," to the existing values in the ",{"t":"code","v":"allow"}," attribute."]},{"t":"p","c":["These three will allow the use of encrypted media extensions to protect the video, grant access to the device's motion and orientation sensors, and allow sharing the ",{"t":"code","v":"iframe"}," content through the device's native share dialogs. "]}],"hints":[{"text":[{"t":"p","c":["The ",{"t":"code","v":"allow"}," attribute of your ",{"t":"code","v":"iframe"}," element should have ",{"t":"code","v":"encrypted-media"}," as one of its values."]}],"test":"const iframeEl = document.querySelector('iframe')\nconst iframeElAllowAttr = iframeEl?.getAttribute('allow')\nassert.match(iframeElAllowAttr, /encrypted-media/)"},{"text":[{"t":"p","c":["The ",{"t":"code","v":"allow"}," attribute of your ",{"t":"code","v":"iframe"}," element should have ",{"t":"code","v":"gyroscope"}," as one of its values."]}],"test":"const iframeEl = document.querySelector('iframe')\nconst iframeElAllowAttr = iframeEl?.getAttribute('allow')\nassert.match(iframeElAllowAttr, /gyroscope/)"},{"text":[{"t":"p","c":["The ",{"t":"code","v":"allow"}," attribute of your ",{"t":"code","v":"iframe"}," element should have ",{"t":"code","v":"web-share"}," as one of its values."]}],"test":"const iframeEl = document.querySelector('iframe')\nconst iframeElAllowAttr = iframeEl?.getAttribute('allow')\nassert.match(iframeElAllowAttr, /web-share/)"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Display Videos in an iframe</title>\n  </head>\n  <body>\n    <h1>iframe Video Display</h1>\n    <iframe\n      width=\"560\"\n      height=\"315\"\n      src=\"https://www.youtube.com/embed/I0_951_MPE0\"\n      allow=\"accelerometer autoplay clipboard-write\"\n    >\n\n    </iframe>\n  </body>\n</html>","editable":[13,14]}]},"solutions":[],"step":6},{"id":"68ba9c4f1688914d72876098","title":"Step 7","dashedName":"step-7","challengeType":0,"description":[{"t":"p","c":["The next attribute you'll add is ",{"t":"code","v":"referrerpolicy"},". It is the rule that determines how much detail you share when your page connects to another page."]},{"t":"p","c":["Add the ",{"t":"code","v":"referrerpolicy"}," attribute and set it to ",{"t":"code","v":"strict-origin-when-cross-origin"},". This shares the full address on the same site, only the site name on other sites, and nothing on insecure sites."]}],"hints":[{"text":[{"t":"p","c":["Your ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"referrerpolicy"}," attribute set to ",{"t":"code","v":"strict-origin-when-cross-origin"},"."]}],"test":"const iframeEl = document.querySelector('iframe')\nassert.equal(iframeEl?.getAttribute('referrerpolicy'), 'strict-origin-when-cross-origin')"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Display Videos in an iframe</title>\n  </head>\n  <body>\n    <h1>iframe Video Display</h1>\n    <iframe\n      width=\"560\"\n      height=\"315\"\n      src=\"https://www.youtube.com/embed/I0_951_MPE0\"\n      allow=\"accelerometer autoplay clipboard-write encrypted-media gyroscope web-share\"\n      \n    >\n\n    </iframe>\n  </body>\n</html>","editable":[14,15]}]},"solutions":[],"step":7},{"id":"68ba9c4f1688914d72876099","title":"Step 8","dashedName":"step-8","challengeType":0,"description":[{"t":"p","c":["Last but not least, the attribute you will add is ",{"t":"code","v":"allowfullscreen"},". As it implies, it allows the video to be viewed in full screen mode."]},{"t":"p","c":["With that, the workshop is completed!"]}],"hints":[{"text":[{"t":"p","c":["Your ",{"t":"code","v":"iframe"}," element should have an ",{"t":"code","v":"allowfullscreen"}," attribute."]}],"test":"const iframeEl = document.querySelector('iframe')\nassert.exists(iframeEl?.getAttribute('allowfullscreen'))"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Display Videos in an iframe</title>\n  </head>\n  <body>\n    <h1>iframe Video Display</h1>\n    <iframe\n      width=\"560\"\n      height=\"315\"\n      src=\"https://www.youtube.com/embed/I0_951_MPE0\"\n      allow=\"accelerometer autoplay clipboard-write encrypted-media gyroscope web-share\"\n      referrerpolicy=\"strict-origin-when-cross-origin\"\n      \n    >\n\n    </iframe>\n  </body>\n</html>","editable":[15,16]}]},"solutions":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Display Videos in an iframe</title>\n  </head>\n  <body>\n    <h1>iframe Video Display</h1>\n    <iframe\n      width=\"560\"\n      height=\"315\"\n      src=\"https://www.youtube.com/embed/I0_951_MPE0\"\n      allow=\"accelerometer autoplay clipboard-write encrypted-media gyroscope web-share\"\n      referrerpolicy=\"strict-origin-when-cross-origin\"\n      allowfullscreen\n    >\n    </iframe>\n  </body>\n</html>"}],"step":8}]}