{"name":"lab-debug-donation-form","kind":"lab","layout":"link","multifile":true,"editableBoundaries":false,"helpCategory":"HTML-CSS","challenges":[{"id":"690ddb5e6ee94eb73ed172b0","title":"Debug a Donation Form","dashedName":"debug-donation-form","challengeType":25,"description":[{"t":"p","c":["A local charity has built a donation form website, but there are several issues that need to be fixed. The form isn't accessible and has some HTML syntax errors."]},{"t":"p","c":["Your job is to fix all of the errors so the form works correctly and is accessible to all users. Complete the items in the user stories below and click \"Check Your Code\" to see if you fixed all the errors."]},{"t":"p","c":[{"t":"strong","c":["User Stories:"]}]},{"t":"ol","items":[[{"t":"p","c":["The ",{"t":"code","v":"input"}," elements are void elements and should not have closing tags. Remove all ",{"t":"code","v":"</input>"}," closing tags from the form."]}],[{"t":"p","c":["Add ",{"t":"code","v":"label"}," elements for each form input field so users know what each field is for. The label text should match what's currently next to each input."]}],[{"t":"p","c":["The ",{"t":"code","v":"Email Address:"}," input type should be an ",{"t":"code","v":"email"}," instead of ",{"t":"code","v":"text"},"."]}],[{"t":"p","c":["You should associate each ",{"t":"code","v":"label"}," element with its corresponding ",{"t":"code","v":"input"}," element using the ",{"t":"code","v":"for"}," attribute on the ",{"t":"code","v":"label"}," and a matching ",{"t":"code","v":"id"}," attribute on the ",{"t":"code","v":"input"},"."]}],[{"t":"p","c":["Add the ",{"t":"code","v":"required"}," attribute to the text, email, and number input fields (but not the checkbox or submit button) to ensure users fill in the required information."]}]]}],"hints":[{"text":[{"t":"p","c":["You should not have any ",{"t":"code","v":"</input>"}," closing tags in your code."]}],"test":"assert.notMatch(code, /<\\/input>/);"},{"text":[{"t":"p","c":["You should have exactly five ",{"t":"code","v":"input"}," elements in your form."]}],"test":"assert.lengthOf(document.querySelectorAll(\"input\"), 5);"},{"text":[{"t":"p","c":["Your first ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"name"}," attribute with a value of ",{"t":"code","v":"name"},"."]}],"test":"assert.exists(document.querySelector(\"input:nth-of-type(1)[name='name']\"));"},{"text":[{"t":"p","c":["Your second ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"name"}," attribute with a value of ",{"t":"code","v":"email"},"."]}],"test":"assert.exists(document.querySelector(\"input:nth-of-type(2)[name='email']\"));"},{"text":[{"t":"p","c":["Your third ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"name"}," attribute with a value of ",{"t":"code","v":"amount"},"."]}],"test":"assert.exists(document.querySelector(\"input:nth-of-type(3)[name='amount']\"));"},{"text":[{"t":"p","c":["Your fourth ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"name"}," attribute with a value of ",{"t":"code","v":"newsletter"},"."]}],"test":"assert.exists(document.querySelector(\"input:nth-of-type(4)[name='newsletter']\"));"},{"text":[{"t":"p","c":["Your fifth ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"type"}," attribute with a value of ",{"t":"code","v":"submit"},"."]}],"test":"assert.exists(document.querySelector(\"input:nth-of-type(5)[type='submit']\"));"},{"text":[{"t":"p","c":["You should have exactly four ",{"t":"code","v":"label"}," elements in your form."]}],"test":"assert.lengthOf(document.querySelectorAll(\"label\"), 4);"},{"text":[{"t":"p","c":["Your first ",{"t":"code","v":"label"}," should have the text ",{"t":"code","v":"Full Name:"},"."]}],"test":"const labels = document.querySelectorAll(\"label\");\nassert.match(labels[0]?.textContent, /Full\\s*Name\\s*:/i);"},{"text":[{"t":"p","c":["Your first ",{"t":"code","v":"input"}," should have a ",{"t":"code","v":"required"}," attribute."]}],"test":"const firstInput = document.querySelector(\"input[name='name']\");\nassert.isTrue(firstInput?.hasAttribute(\"required\"));"},{"text":[{"t":"p","c":["Your second ",{"t":"code","v":"label"}," should have the text ",{"t":"code","v":"Email Address:"},"."]}],"test":"const labels = document.querySelectorAll(\"label\");\nassert.match(labels[1]?.textContent, /Email\\s*Address\\s*:/i);"},{"text":[{"t":"p","c":["Your second ",{"t":"code","v":"input"}," should have a ",{"t":"code","v":"required"}," attribute."]}],"test":"const secondInput = document.querySelector(\"input[name='email']\");\nassert.isTrue(secondInput?.hasAttribute(\"required\"));"},{"text":[{"t":"p","c":["Your third ",{"t":"code","v":"label"}," should have the text ",{"t":"code","v":"Donation Amount ($):"},"."]}],"test":"const labels = document.querySelectorAll(\"label\");\nassert.match(labels[2]?.textContent, /Donation\\s*Amount\\s*\\(\\$\\)\\s*:/i);"},{"text":[{"t":"p","c":["Your third ",{"t":"code","v":"input"}," should have a ",{"t":"code","v":"required"}," attribute."]}],"test":"const thirdInput = document.querySelector(\"input[name='amount']\");\nassert.isTrue(thirdInput?.hasAttribute(\"required\"));"},{"text":[{"t":"p","c":["Your fourth ",{"t":"code","v":"label"}," should have the text ",{"t":"code","v":"Subscribe"},"."]}],"test":"const labels = document.querySelectorAll(\"label\");\nassert.match(labels[3]?.textContent, /Subscribe/i);"},{"text":[{"t":"p","c":["You should associate every ",{"t":"code","v":"input"}," element with a ",{"t":"code","v":"label"}," element using the ",{"t":"code","v":"for"}," and ",{"t":"code","v":"id"}," attributes."]}],"test":"const els = document.querySelectorAll('input:not([type=\"submit\"])'); \nassert.isNotEmpty(els); \nels.forEach(input => { \n  const label = document.querySelector(`label[for=\"${input.id}\"]`); \n  assert.exists(label);  \n  assert.equal(label.tagName, \"LABEL\"); \n})"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"input"}," for the email address should be of type ",{"t":"code","v":"email"},"."]}],"test":"const emailInput = document.querySelector(\"input[name='email']\");\nassert.strictEqual(emailInput?.getAttribute(\"type\"), \"email\");"},{"text":[{"t":"p","c":["Your checkbox ",{"t":"code","v":"input"}," should not have a ",{"t":"code","v":"required"}," attribute."]}],"test":"const checkboxInput = document.querySelector(\"input[name='newsletter']\");\nassert.isFalse(checkboxInput?.hasAttribute(\"required\"));"},{"text":[{"t":"p","c":["Your submit ",{"t":"code","v":"button"}," should not have a ",{"t":"code","v":"required"}," attribute."]}],"test":"const submitButton = document.querySelector(\"input[type='submit']\");\nassert.isFalse(submitButton?.hasAttribute(\"required\"));"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Donation Form</title>\n</head>\n<body>\n  <h1>Donation Form</h1>\n  <form>\n    \n    Full Name:\n    <input type=\"text\" name=\"name\"></input>\n\n    Email Address:\n    <input type=\"text\" name=\"email\">\n\n    Donation Amount ($):\n    <input type=\"number\" name=\"amount\"></input>\n\n    <input type=\"checkbox\" name=\"newsletter\"></input>\n    Subscribe\n\n    <input type=\"submit\" value=\"Send\"></input>\n  </form>\n</body>\n</html>"}]},"solutions":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Donation Form</title>\n</head>\n<body>\n  <h1>Donation Form</h1>\n  <form>\n    <label for=\"full-name\">Full Name:</label>\n    <input id=\"full-name\" type=\"text\" name=\"name\" required>\n\n    <label for=\"email\">Email Address:</label>\n    <input id=\"email\" type=\"email\" name=\"email\" required>\n\n    <label for=\"amount\">Donation Amount ($):</label>\n    <input id=\"amount\" type=\"number\" name=\"amount\" required>\n\n    <label for=\"newsletter\">Subscribe</label>\n    <input id=\"newsletter\" type=\"checkbox\" name=\"newsletter\">\n\n    <input type=\"submit\" value=\"Send\">\n  </form>\n</body>\n</html>"}]}]}