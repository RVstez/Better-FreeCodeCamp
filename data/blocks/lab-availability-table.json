{"name":"lab-availability-table","kind":"lab","layout":"link","multifile":true,"editableBoundaries":false,"helpCategory":"HTML-CSS","challenges":[{"id":"66b36358ed4f261d64840c24","title":"Build an Availability Table","dashedName":"build-an-availability-table","challengeType":25,"demoType":"onClick","description":[{"t":"p","c":[{"t":"strong","c":["Objective:"]}," Fulfill the user stories below and get all the tests to pass to complete the lab."]},{"t":"p","c":[{"t":"strong","c":["User Stories:"]}]},{"t":"ol","items":[[{"t":"p","c":["You should have a table with at least three columns and five rows, headers included."]}],[{"t":"p","c":["The first row should have table header cells containing days of the week."]}],[{"t":"p","c":["The first column should have table header cells with a ",{"t":"code","v":"class"}," of ",{"t":"code","v":"time"}," containing time values as their text."]}],[{"t":"p","c":["All data cells should have the ",{"t":"code","v":"class"}," of ",{"t":"code","v":"available-#"},", where ",{"t":"code","v":"#"}," is a number from ",{"t":"code","v":"0"}," to ",{"t":"code","v":"5"}," that specifies the number of available people at that time."]}],[{"t":"p","c":["Your table should have a ",{"t":"code","v":"caption"}," element with the text ",{"t":"code","v":"Weekly Meeting Availability Schedule"},"."]}],[{"t":"p","c":["All table header cells in the first row (the days of the week) should have a ",{"t":"code","v":"scope"}," attribute with the value ",{"t":"code","v":"col"},"."]}],[{"t":"p","c":["All table header cells in the first column (the time cells) should have a ",{"t":"code","v":"scope"}," attribute with the value ",{"t":"code","v":"row"},"."]}],[{"t":"p","c":["All data cells with an availability class should have an ",{"t":"code","v":"aria-label"}," attribute that describes the availability level (e.g., ",{"t":"code","v":"0 available"}," for the ",{"t":"code","v":"available-0"}," cells, ",{"t":"code","v":"1 available"}," for the ",{"t":"code","v":"available-1"}," cells, etc., and ",{"t":"code","v":"5+ available"}," for the ",{"t":"code","v":"available-5"}," cells)."]}],[{"t":"p","c":["In your ",{"t":"code","v":":root"}," selector, you should define six CSS variables named ",{"t":"code","v":"--color#"},", where ",{"t":"code","v":"#"}," is a number from ",{"t":"code","v":"0"}," to ",{"t":"code","v":"5"},", and assign them each a color value. Use these variables to set the background color of the corresponding ",{"t":"code","v":".available-#"}," elements."]}],[{"t":"p","c":["In your ",{"t":"code","v":":root"}," selector, you should define CSS variables named ",{"t":"code","v":"--solid-border"}," and ",{"t":"code","v":"--dashed-border"},". Use these variables to style the bottom borders of your data cells, alternating between solid and dashed borders depending on the row. Give the rows either the class of ",{"t":"code","v":"sharp"}," or ",{"t":"code","v":"half"}," to style them."]}],[{"t":"p","c":["You should have a ",{"t":"code","v":"div"}," element with the ",{"t":"code","v":"id"}," of ",{"t":"code","v":"legend"},". It should contain a ",{"t":"code","v":"span"}," element with the text ",{"t":"code","v":"Availability"}," and a ",{"t":"code","v":"div"}," element with the ",{"t":"code","v":"id"}," of ",{"t":"code","v":"legend-gradient"},"."]}],[{"t":"p","c":["You should give the ",{"t":"code","v":"#legend-gradient"}," element a linear gradient that transitions between all the colors from ",{"t":"code","v":"--color0"}," to ",{"t":"code","v":"--color5"}," with hard lines."]}]]},{"t":"p","c":[{"t":"strong","c":["Note:"]}," Be sure to link your stylesheet in your HTML to apply your CSS."]}],"hints":[{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"table"}," element."]}],"test":"assert.isNotNull(document.querySelector('table'));"},{"text":[{"t":"p","c":["You should have only one ",{"t":"code","v":"table"}," element."]}],"test":"assert.lengthOf(document.querySelectorAll('table'), 1);"},{"text":[{"t":"p","c":["Your table should have at least ",{"t":"code","v":"5"}," rows."]}],"test":"assert.isAtLeast(document.querySelectorAll('tr')?.length, 5);"},{"text":[{"t":"p","c":["Your table should have at least ",{"t":"code","v":"3"}," columns."]}],"test":"const rows = [...document.querySelectorAll('tr')];\nassert.isNotEmpty(rows);\nrows.forEach((row) => {\n    assert.isAtLeast(row.children.length, 3);\n})"},{"text":[{"t":"p","c":["The first row in your table should contain at least three ",{"t":"code","v":"th"}," elements."]}],"test":"assert.isAtLeast(document.querySelectorAll('tr:first-child>th').length, 3)"},{"text":[{"t":"p","c":["The first row in your table should not contain ",{"t":"code","v":"td"}," elements."]}],"test":"const firstRow = document.querySelector('tr');\nassert.isNotNull(firstRow);\nassert.isEmpty(firstRow.querySelectorAll('td'));"},{"text":[{"t":"p","c":["You should have at least two rows with the class of ",{"t":"code","v":"sharp"},"."]}],"test":"assert.isAtLeast(document.querySelectorAll('tr[class~=\"sharp\"]').length, 2);"},{"text":[{"t":"p","c":["You should have at least two rows with the class of ",{"t":"code","v":"half"},"."]}],"test":"assert.isAtLeast(document.querySelectorAll('tr[class~=\"half\"]').length, 2);"},{"text":[{"t":"p","c":[{"t":"code","v":"th"}," elements in the first column should have the ",{"t":"code","v":"class"}," of ",{"t":"code","v":"time"}," and contain time values."]}],"test":"const firstColumnData = [...document.querySelectorAll('tr th:first-child')];\nassert.isNotEmpty(firstColumnData);\nfor (let cell of firstColumnData) {\n    if (cell.innerText.match(/\\d/)?.length) {\n        assert.isTrue(cell.classList.contains('time'));\n    }\n}"},{"text":[{"t":"p","c":["You should have at least four ",{"t":"code","v":"th"}," elements with the class of ",{"t":"code","v":"time"}," that contain time values."]}],"test":"const timeClass = document.querySelectorAll('.time');\nassert.isAtLeast(timeClass.length, 4);\nfor (let cell of timeClass) {\n    assert.match(cell.innerText, /\\d/)\n}"},{"text":[{"t":"p","c":["All your ",{"t":"code","v":"td"}," elements should have the ",{"t":"code","v":"class"}," of ",{"t":"code","v":"available-#"},", where ",{"t":"code","v":"#"}," is a number from ",{"t":"code","v":"0"}," to ",{"t":"code","v":"5"},"."]}],"test":"const cells = [...document.querySelectorAll('tr[class=\"sharp\"]>td, tr[class=\"half\"]>td')];\nassert.isNotEmpty(cells);\nfor (let cell of cells) {\n    const classString = [...cell.classList].join(' ');\n    assert.lengthOf(classString.match(/(?<=\\s|^)available-[0-5](?=\\s|$)/gm), 1);\n}"},{"text":[{"t":"p","c":["You should have at least eight ",{"t":"code","v":".available-#"}," elements, where ",{"t":"code","v":"#"}," is a number between ",{"t":"code","v":"0"}," and ",{"t":"code","v":"5"},"."]}],"test":"assert.isAtLeast(document.querySelectorAll('td[class*=\"available-\"]').length, 8);"},{"text":[{"t":"p","c":["You should define a ",{"t":"code","v":"--color0"}," variable in your root selector."]}],"test":"const root = new __helpers.CSSHelp(document).getStyle(':root');\nassert.exists(root); \nassert.isNotEmpty(root.getPropVal('--color0'))"},{"text":[{"t":"p","c":["You should define a ",{"t":"code","v":"--color1"}," variable in your root selector."]}],"test":"const root = new __helpers.CSSHelp(document).getStyle(':root');\nassert.exists(root); \nassert.isNotEmpty(root.getPropVal('--color1'))"},{"text":[{"t":"p","c":["You should define a ",{"t":"code","v":"--color2"}," variable in your root selector."]}],"test":"const root = new __helpers.CSSHelp(document).getStyle(':root');\nassert.exists(root); \nassert.isNotEmpty(root.getPropVal('--color2'))"},{"text":[{"t":"p","c":["You should define a ",{"t":"code","v":"--color3"}," variable in your root selector."]}],"test":"const root = new __helpers.CSSHelp(document).getStyle(':root');\nassert.exists(root); \nassert.isNotEmpty(root.getPropVal('--color3'));"},{"text":[{"t":"p","c":["You should define a ",{"t":"code","v":"--color4"}," variable in your root selector."]}],"test":"const root = new __helpers.CSSHelp(document).getStyle(':root');\nassert.exists(root); \nassert.isNotEmpty(root.getPropVal('--color4'));"},{"text":[{"t":"p","c":["You should define a ",{"t":"code","v":"--color5"}," variable in your root selector."]}],"test":"const root = new __helpers.CSSHelp(document).getStyle(':root');\nassert.exists(root); \nassert.isNotEmpty(root.getPropVal('--color5'));"},{"text":[{"t":"p","c":["You should use ",{"t":"code","v":"--color0"}," to set the background color of ",{"t":"code","v":".available-0"}," elements."]}],"test":"const a = new __helpers.CSSHelp(document).getStyle('.available-0');\nassert.exists(a); \nassert.strictEqual(a.backgroundColor, 'var(--color0)');"},{"text":[{"t":"p","c":["You should use ",{"t":"code","v":"--color1"}," to set the background color of ",{"t":"code","v":".available-1"}," elements."]}],"test":"const a = new __helpers.CSSHelp(document).getStyle('.available-1');\nassert.exists(a); \nassert.strictEqual(a.backgroundColor, 'var(--color1)');"},{"text":[{"t":"p","c":["You should use ",{"t":"code","v":"--color2"}," to set the background color of ",{"t":"code","v":".available-2"}," elements."]}],"test":"const a = new __helpers.CSSHelp(document).getStyle('.available-2');\nassert.exists(a); \nassert.strictEqual(a.backgroundColor, 'var(--color2)');"},{"text":[{"t":"p","c":["You should use ",{"t":"code","v":"--color3"}," to set the background color of ",{"t":"code","v":".available-3"}," elements."]}],"test":"const a = new __helpers.CSSHelp(document).getStyle('.available-3');\nassert.exists(a); \nassert.strictEqual(a.backgroundColor, 'var(--color3)');"},{"text":[{"t":"p","c":["You should use ",{"t":"code","v":"--color4"}," to set the background color of ",{"t":"code","v":".available-4"}," elements."]}],"test":"const a = new __helpers.CSSHelp(document).getStyle('.available-4');\nassert.exists(a); \nassert.strictEqual(a.backgroundColor, 'var(--color4)');"},{"text":[{"t":"p","c":["You should use ",{"t":"code","v":"--color5"}," to set the background color of ",{"t":"code","v":".available-5"}," elements."]}],"test":"const a = new __helpers.CSSHelp(document).getStyle('.available-5');\nassert.exists(a); \nassert.strictEqual(a.backgroundColor, 'var(--color5)');"},{"text":[{"t":"p","c":["You should define a ",{"t":"code","v":"--solid-border"}," variable in your root selector."]}],"test":"const root = new __helpers.CSSHelp(document).getStyle(':root');\nassert.exists(root); \nassert.isNotEmpty(root.getPropVal('--solid-border'));"},{"text":[{"t":"p","c":["You should define a ",{"t":"code","v":"--dashed-border"}," variable in your root selector."]}],"test":"const root = new __helpers.CSSHelp(document).getStyle(':root');\nassert.exists(root); \nassert.isNotEmpty(root.getPropVal('--dashed-border'));"},{"text":[{"t":"p","c":["You should target ",{"t":"code","v":"td"}," elements that are children of ",{"t":"code","v":".sharp"}," elements."]}],"test":"const tds = new __helpers.CSSHelp(document).getStyle('.sharp td') || new __helpers.CSSHelp(document).getStyle('.sharp>td');\nassert.exists(tds);"},{"text":[{"t":"p","c":["You should use ",{"t":"code","v":"--solid-border"}," to set the ",{"t":"code","v":"bottom-border"}," of ",{"t":"code","v":"td"}," elements that are children of ",{"t":"code","v":".sharp"}," elements."]}],"test":"const tds = new __helpers.CSSHelp(document).getStyle('.sharp td') || new __helpers.CSSHelp(document).getStyle('.sharp>td');\nassert.exists(tds);\nassert.strictEqual(tds.borderBottom, 'var(--solid-border)');"},{"text":[{"t":"p","c":["You should target ",{"t":"code","v":"td"}," elements that are children of ",{"t":"code","v":".half"}," elements."]}],"test":"const tds = new __helpers.CSSHelp(document).getStyle('.half td') || new __helpers.CSSHelp(document).getStyle('.half>td');\nassert.exists(tds);"},{"text":[{"t":"p","c":["You should use ",{"t":"code","v":"--dashed-border"}," to set the ",{"t":"code","v":"bottom-border"}," of ",{"t":"code","v":"td"}," elements of ",{"t":"code","v":".half"}," elements."]}],"test":"const tds = new __helpers.CSSHelp(document).getStyle('.half td') || new __helpers.CSSHelp(document).getStyle('.half>td');\nassert.exists(tds);\nassert.strictEqual(tds.borderBottom, 'var(--dashed-border)');"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"div"}," element with the ",{"t":"code","v":"id"}," of ",{"t":"code","v":"legend"},"."]}],"test":"assert.equal(document.querySelector('#legend')?.tagName, 'DIV');"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"span"}," element with the text ",{"t":"code","v":"Availability"}," inside your ",{"t":"code","v":"#legend"},"."]}],"test":"assert.equal(document.querySelector('#legend span')?.textContent.trim(), 'Availability');"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"div"}," element with the ",{"t":"code","v":"id"}," of ",{"t":"code","v":"legend-gradient"}," inside your ",{"t":"code","v":"#legend"},"."]}],"test":"assert.equal(document.querySelector('#legend #legend-gradient')?.tagName, 'DIV');"},{"text":[{"t":"p","c":["You should set the background image of ",{"t":"code","v":"#legend-gradient"}," to a linear gradient."]}],"test":"const legendGradient = new __helpers.CSSHelp(document).getStyle('#legend-gradient');\nassert.exists(legendGradient); \nassert.include(legendGradient.backgroundImage, \"linear-gradient(\")"},{"text":[{"t":"p","c":["You should have the transitions from one color to the following color as a hard line for your ",{"t":"code","v":"#legend-gradient"},". Make sure your percentages are whole numbers."]}],"test":"const legendGradient = new __helpers.CSSHelp(document).getStyle('#legend-gradient');\nassert.exists(legendGradient);\nconst gradientStr = legendGradient.backgroundImage;\n\nconst COLOR_COUNT = 6;\nconst EXPECTED_SHORTHAND_STOPS = 6;\nconst EXPECTED_EXPANDED_STOPS = 12;\n\nfor (let i = 0; i < COLOR_COUNT; i++) {\n  assert.include(gradientStr, `--color${i}`, `gradient should include --color${i}`);\n}\n\nconst GRADIENT_PATTERNS = {\n  SHORTHAND: /var\\(\\s*--color[0-5]\\s*\\)\\s+\\d+%\\s+\\d+%/g,\n  EXPANDED: /var\\(\\s*--color[0-5]\\s*\\)\\s+\\d+%(?!\\s+\\d+%)/g\n};\n\nconst matchGradientFormat = (gradientStr, pattern) => gradientStr.match(pattern);\n\nconst shorthandMatches = matchGradientFormat(gradientStr, GRADIENT_PATTERNS.SHORTHAND);\nconst expandedMatches = matchGradientFormat(gradientStr, GRADIENT_PATTERNS.EXPANDED);\n\nconst colorPattern = /var\\(\\s*--color(\\d)\\s*\\)/g;\nconst allColorMatches = [...gradientStr.matchAll(colorPattern)];\nconst colorNumbers = allColorMatches.map(match => parseInt(match[1]));\n\nif (shorthandMatches?.length === EXPECTED_SHORTHAND_STOPS) {\n  for (let i = 0; i < COLOR_COUNT; i++) {\n    const count = colorNumbers.filter(num => num === i).length;\n    assert.equal(count, 1, `In shorthand format, --color${i} should appear exactly once, but it appears ${count} times`);\n  }\n  \n  for (let i = 0; i < COLOR_COUNT; i++) {\n    const idx = colorNumbers.indexOf(i);\n    assert.isAtLeast(idx, 0, `--color${i} should be in the gradient`);\n    if (i > 0) {\n      const prevIdx = colorNumbers.indexOf(i - 1);\n      assert.isBelow(prevIdx, idx, `--color${i - 1} should appear before --color${i}`);\n    }\n  }\n} else if (expandedMatches?.length === EXPECTED_EXPANDED_STOPS) {\n  for (let i = 0; i < COLOR_COUNT; i++) {\n    const count = colorNumbers.filter(num => num === i).length;\n    assert.equal(count, 2, `In expanded format, --color${i} should appear exactly twice, but it appears ${count} times`);\n  }\n  \n  for (let i = 0; i < COLOR_COUNT; i++) {\n    const firstIdx = colorNumbers.indexOf(i);\n    const lastIdx = colorNumbers.lastIndexOf(i);\n    assert.equal(lastIdx - firstIdx, 1, `--color${i} should appear in consecutive positions for hard lines`);\n    \n    if (i > 0) {\n      const prevLastIdx = colorNumbers.lastIndexOf(i - 1);\n      assert.isBelow(prevLastIdx, firstIdx, `--color${i - 1} should complete before --color${i} starts`);\n    }\n  }\n  \n  const percentPattern = /var\\(\\s*--color\\d\\s*\\)\\s+(\\d+)%/g;\n  const percentMatches = [...gradientStr.matchAll(percentPattern)];\n  const percentages = percentMatches.map(match => parseInt(match[1]));\n  \n  for (let i = 1; i < percentages.length - 1; i += 2) {\n    assert.equal(percentages[i], percentages[i + 1], `For hard lines, percentage at position ${i} (${percentages[i]}%) should equal percentage at position ${i + 1} (${percentages[i + 1]}%) where colors meet`);\n  }\n} else {\n  assert.fail('Gradient must use either shorthand format (6 stops with two percentages each) or expanded format (12 stops with one percentage each)');\n}"},{"text":[{"t":"p","c":["Your table should have a ",{"t":"code","v":"caption"}," element."]}],"test":"const caption = document.querySelector('table caption');\nassert.isNotNull(caption);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"caption"}," element should have the text ",{"t":"code","v":"Weekly Meeting Availability Schedule"},"."]}],"test":"const caption = document.querySelector('table caption');\nassert.equal(caption?.textContent, 'Weekly Meeting Availability Schedule');"},{"text":[{"t":"p","c":["All table header cells in the first row should have a ",{"t":"code","v":"scope"}," attribute with the value ",{"t":"code","v":"col"},"."]}],"test":"const headers = [...document.querySelectorAll('tr:first-child>th:not([class*=\"time\"])')];\nassert.isNotEmpty(headers);\nheaders.forEach(header => {\n    assert.equal(header.getAttribute('scope'), 'col');\n});"},{"text":[{"t":"p","c":["All table header cells in the first column should have a ",{"t":"code","v":"scope"}," attribute with the value ",{"t":"code","v":"row"},"."]}],"test":"const timeHeaders = [...document.querySelectorAll('th.time')];\nassert.isNotEmpty(timeHeaders);\ntimeHeaders.forEach(header => {\n    assert.equal(header.getAttribute('scope'), 'row');\n});"},{"text":[{"t":"p","c":["All data cells with an availability class should have an ",{"t":"code","v":"aria-label"}," attribute."]}],"test":"const dataCells = [...document.querySelectorAll('td[class*=\"available\"]')];\nassert.isNotEmpty(dataCells);\ndataCells.forEach(cell => {\n    assert.isNotNull(cell.getAttribute('aria-label'));\n});"},{"text":[{"t":"p","c":["Data cells with the ",{"t":"code","v":"available-0"}," class should have an ",{"t":"code","v":"aria-label"}," of ",{"t":"code","v":"0 available"}," if present."]}],"test":"const cells = [...document.querySelectorAll('td.available-0')];\ncells.forEach(cell => {\n    assert.equal(cell.getAttribute('aria-label'), '0 available');\n});"},{"text":[{"t":"p","c":["Data cells with the ",{"t":"code","v":"available-1"}," class should have an ",{"t":"code","v":"aria-label"}," of ",{"t":"code","v":"1 available"}," if present."]}],"test":"const cells = [...document.querySelectorAll('td.available-1')];\ncells.forEach(cell => {\n    assert.equal(cell.getAttribute('aria-label'), '1 available');\n});"},{"text":[{"t":"p","c":["Data cells with the ",{"t":"code","v":"available-2"}," class should have an ",{"t":"code","v":"aria-label"}," of ",{"t":"code","v":"2 available"}," if present."]}],"test":"const cells = [...document.querySelectorAll('td.available-2')];\ncells.forEach(cell => {\n    assert.equal(cell.getAttribute('aria-label'), '2 available');\n});"},{"text":[{"t":"p","c":["Data cells with the ",{"t":"code","v":"available-3"}," class should have an ",{"t":"code","v":"aria-label"}," of ",{"t":"code","v":"3 available"}," if present."]}],"test":"const cells = [...document.querySelectorAll('td.available-3')];\ncells.forEach(cell => {\n    assert.equal(cell.getAttribute('aria-label'), '3 available');\n});"},{"text":[{"t":"p","c":["Data cells with the ",{"t":"code","v":"available-4"}," class should have an ",{"t":"code","v":"aria-label"}," of ",{"t":"code","v":"4 available"}," if present."]}],"test":"const cells = [...document.querySelectorAll('td.available-4')];\ncells.forEach(cell => {\n    assert.equal(cell.getAttribute('aria-label'), '4 available');\n});"},{"text":[{"t":"p","c":["Data cells with the ",{"t":"code","v":"available-5"}," class should have an ",{"t":"code","v":"aria-label"}," of ",{"t":"code","v":"5+ available"}," if present."]}],"test":"const cells = [...document.querySelectorAll('td.available-5')];\ncells.forEach(cell => {\n    assert.equal(cell.getAttribute('aria-label'), '5+ available');\n});"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Availability Table</title>\n</head>\n\n<body>\n\n</body>\n\n</html>"},{"lang":"css","contents":""}]},"solutions":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Availability Table</title>\n    <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n\n<body>\n    <main>\n        <table>\n            <caption>Weekly Meeting Availability Schedule</caption>\n            <tbody>\n                <tr class=\"sharp\">\n                    <th rowspan=\"2\" class=\"time\" scope=\"row\">9 AM</th>\n                    <th scope=\"col\">Monday</th>\n                    <th scope=\"col\">Tuesday</th>\n                    <th scope=\"col\">Wednesday</th>\n                    <th scope=\"col\">Thursday</th>\n                    <th scope=\"col\">Friday</th>\n                </tr>\n                <tr class=\"half\">\n                    <td class=\"available-0\" aria-label=\"0 available\"></td>\n                    <td class=\"available-1\" aria-label=\"1 available\"></td>\n                    <td class=\"available-2\" aria-label=\"2 available\"></td>\n                    <td class=\"available-2\" aria-label=\"2 available\"></td>\n                    <td class=\"available-5\" aria-label=\"5+ available\"></td>\n                </tr>\n                <tr class=\"sharp\">\n                    <th rowspan=\"2\" class=\"time\" scope=\"row\">10 AM</th>\n                    <td class=\"available-3\" aria-label=\"3 available\"></td>\n                    <td class=\"available-4\" aria-label=\"4 available\"></td>\n                    <td class=\"available-4\" aria-label=\"4 available\"></td>\n                    <td class=\"available-5\" aria-label=\"5+ available\"></td>\n                    <td class=\"available-5\" aria-label=\"5+ available\"></td>\n                </tr>\n\n                <tr class=\"half\">\n                    <td class=\"available-3\" aria-label=\"3 available\"></td>\n                    <td class=\"available-4\" aria-label=\"4 available\"></td>\n                    <td class=\"available-5\" aria-label=\"5+ available\"></td>\n                    <td class=\"available-5\" aria-label=\"5+ available\"></td>\n                    <td class=\"available-5\" aria-label=\"5+ available\"></td>\n                </tr>\n                <tr class=\"sharp\">\n                    <th rowspan=\"2\" class=\"time\" scope=\"row\">11 AM</th>\n                    <td class=\"available-0\" aria-label=\"0 available\"></td>\n                    <td class=\"available-2\" aria-label=\"2 available\"></td>\n                    <td class=\"available-4\" aria-label=\"4 available\"></td>\n                    <td class=\"available-4\" aria-label=\"4 available\"></td>\n                    <td class=\"available-0\" aria-label=\"0 available\"></td>\n                </tr>\n                <tr class=\"half\">\n                    <td class=\"available-3\" aria-label=\"3 available\"></td>\n                    <td class=\"available-4\" aria-label=\"4 available\"></td>\n                    <td class=\"available-1\" aria-label=\"1 available\"></td>\n                    <td class=\"available-5\" aria-label=\"5+ available\"></td>\n                    <td class=\"available-5\" aria-label=\"5+ available\"></td>\n                </tr>\n                <tr class=\"sharp\">\n                    <th rowspan=\"2\" class=\"time\" scope=\"row\">12 PM</th>\n                    <td class=\"available-5\" aria-label=\"5+ available\"></td>\n                    <td class=\"available-5\" aria-label=\"5+ available\"></td>\n                    <td class=\"available-3\" aria-label=\"3 available\"></td>\n                    <td class=\"available-2\" aria-label=\"2 available\"></td>\n                    <td class=\"available-0\" aria-label=\"0 available\"></td>\n                </tr>\n                <tr class=\"half\">\n                    <td class=\"available-3\" aria-label=\"3 available\"></td>\n                    <td class=\"available-0\" aria-label=\"0 available\"></td>\n                    <td class=\"available-4\" aria-label=\"4 available\"></td>\n                    <td class=\"available-5\" aria-label=\"5+ available\"></td>\n                    <td class=\"available-5\" aria-label=\"5+ available\"></td>\n                </tr>\n                <tr class=\"sharp\">\n                    <th rowspan=\"2\" class=\"time\" scope=\"row\">1 PM</th>\n                    <td class=\"available-2\" aria-label=\"2 available\"></td>\n                    <td class=\"available-3\" aria-label=\"3 available\"></td>\n                    <td class=\"available-3\" aria-label=\"3 available\"></td>\n                    <td class=\"available-2\" aria-label=\"2 available\"></td>\n                    <td class=\"available-0\" aria-label=\"0 available\"></td>\n                </tr>\n                <tr class=\"half\">\n                    <td class=\"available-3\" aria-label=\"3 available\"></td>\n                    <td class=\"available-4\" aria-label=\"4 available\"></td>\n                    <td class=\"available-4\" aria-label=\"4 available\"></td>\n                    <td class=\"available-5\" aria-label=\"5+ available\"></td>\n                    <td class=\"ava