{"name":"lab-travel-agency-page","kind":"lab","layout":"link","multifile":true,"editableBoundaries":false,"helpCategory":"HTML-CSS","challenges":[{"id":"669e2f60e83c011754f711f9","title":"Build a Travel Agency Page","dashedName":"build-a-travel-agency-page","challengeType":25,"demoType":"onClick","description":[{"t":"p","c":[{"t":"strong","c":["Objective:"]}," Fulfill the user stories below and get all the tests to pass to complete the lab."]},{"t":"p","c":[{"t":"strong","c":["User Stories:"]}]},{"t":"ol","items":[[{"t":"p","c":["You should have a ",{"t":"code","v":"DOCTYPE"}," declaration."]}],[{"t":"p","c":["You should have an ",{"t":"code","v":"html"}," element with ",{"t":"code","v":"lang"}," set to ",{"t":"code","v":"en"},"."]}],[{"t":"p","c":["You should have a ",{"t":"code","v":"head"}," element containing a ",{"t":"code","v":"meta"}," void element with ",{"t":"code","v":"charset"}," set to ",{"t":"code","v":"utf-8"}," and a ",{"t":"code","v":"title"}," with the text ",{"t":"code","v":"Travel Agency Page"},"."]}],[{"t":"p","c":["You should have a ",{"t":"code","v":"meta"}," tag in your ",{"t":"code","v":"head"}," element that contains a short description of your website for SEO."]}],[{"t":"p","c":["You should have an ",{"t":"code","v":"h1"}," element to present your travel destinations. It should be the only ",{"t":"code","v":"h1"}," element on your page."]}],[{"t":"p","c":["You should have a paragraph below the ",{"t":"code","v":"h1"}," element introducing the travel opportunities."]}],[{"t":"p","c":["You should have an ",{"t":"code","v":"h2"}," element with the text ",{"t":"code","v":"Packages"},"."]}],[{"t":"p","c":["You should have a ",{"t":"code","v":"p"}," element introducing briefly the various packages."]}],[{"t":"p","c":["You should have an unordered list element with two list items. The two list items should have the text ",{"t":"code","v":"Group Travels"}," and ",{"t":"code","v":"Private Tours"},", respectively. The text of each list item should be enclosed by an anchor element."]}],[{"t":"p","c":["You should have an ",{"t":"code","v":"h2"}," element with the text ",{"t":"code","v":"Top Itineraries"},"."]}],[{"t":"p","c":["You should have at least three ",{"t":"code","v":"figure"}," elements, each containing an anchor element and a ",{"t":"code","v":"figcaption"}," element that describes the figure's image."]}],[{"t":"p","c":["The three anchor elements should have an ",{"t":"code","v":"img"}," element with an appropriate ",{"t":"code","v":"alt"}," attribute and a ",{"t":"code","v":"src"}," attribute set to a valid image as their content. You can use ",{"t":"code","v":"https://cdn.freecodecamp.org/curriculum/labs/colosseo.jpg"},", ",{"t":"code","v":"https://cdn.freecodecamp.org/curriculum/labs/alps.jpg"},", and ",{"t":"code","v":"https://cdn.freecodecamp.org/curriculum/labs/sea.jpg"}," if you would like."]}],[{"t":"p","c":["All your five anchor elements should have an ",{"t":"code","v":"href"}," attribute with the value of ",{"t":"code","v":"https://www.freecodecamp.org/learn"}," and a ",{"t":"code","v":"target"}," attribute with the value of ",{"t":"code","v":"_blank"},"."]}]]}],"hints":[{"text":[{"t":"p","c":["Your travel agency page should have a ",{"t":"code","v":"!DOCTYPE html"}," declaration."]}],"test":"assert.match(code, /<!DOCTYPE\\s+html>/i);"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"html"}," element with ",{"t":"code","v":"lang"}," set to ",{"t":"code","v":"en"},"."]}],"test":"assert.match(code, /<\\s*html(?=[\\s>])[^>]*\\slang\\s*=\\s*('|\")en\\1[^>]*>/i);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"html"}," element should have a closing tag."]}],"test":"assert.match(code, /<\\/html\\s*>/i);"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"head"}," element within the ",{"t":"code","v":"html"}," element."]}],"test":"assert.match(\n  code,\n  /<\\s*html(?=[\\s>])[^>]*>(?:(?!<\\/html\\s*>)[\\s\\S])*<\\s*head\\s*>/i\n);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"head"}," element should have a closing tag."]}],"test":"assert.match(code, /<\\/head\\s*>/i);"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"title"}," element within your ",{"t":"code","v":"head"}," element."]}],"test":"assert.isNotNull(document.querySelector('head title'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"title"}," element should have a closing tag."]}],"test":"assert.match(code, /<\\/title\\s*>/i);"},{"text":[{"t":"p","c":["You should have two ",{"t":"code","v":"meta"}," elements within your ",{"t":"code","v":"head"}," element."]}],"test":"assert.isAtLeast(document.querySelectorAll('head meta').length, 2);"},{"text":[{"t":"p","c":["One ",{"t":"code","v":"meta"}," element should have a ",{"t":"code","v":"name"}," attribute with value of ",{"t":"code","v":"description"}," and a non-empty ",{"t":"code","v":"content"}," attribute."]}],"test":"assert(\n  Array.from(document.querySelectorAll('head meta')).some(\n    (meta) =>\n      meta.getAttribute('name')?.toLowerCase() === 'description' &&\n      meta.getAttribute('content')?.trim()\n  )\n);"},{"text":[{"t":"p","c":["One ",{"t":"code","v":"meta"}," element should have its ",{"t":"code","v":"charset"}," attribute set to ",{"t":"code","v":"utf-8"},"."]}],"test":"const charsetMeta = document.querySelector('head meta[charset]');\nassert.equal(charsetMeta?.getAttribute('charset')?.toLowerCase(), 'utf-8');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"title"}," element should have your travel agency name."]}],"test":"assert.isAbove(document.querySelector('title')?.innerText.trim().length, 0);"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"body"}," element within your ",{"t":"code","v":"html"}," element."]}],"test":"assert.match(\n  code,\n  /<\\s*html(?=[\\s>])[^>]*>(?:(?!<\\/html\\s*>)[\\s\\S])*<\\s*head\\s*>(?:(?!<\\/html\\s*>)[\\s\\S])*<\\s*body\\s*>/i\n);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"body"}," element should have a closing tag."]}],"test":"assert.match(code, /<\\/body\\s*>/i);"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"h1"}," element to present your travel destinations."]}],"test":"assert.isAbove(document.querySelector('h1')?.innerText.length, 0);"},{"text":[{"t":"p","c":["You should only have one ",{"t":"code","v":"h1"}," element."]}],"test":"assert.lengthOf(document.querySelectorAll('h1'), 1);"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"p"}," element below the ",{"t":"code","v":"h1"}," element."]}],"test":"assert.strictEqual(\n  document.querySelector('h1')?.nextElementSibling.tagName, 'P'\n);"},{"text":[{"t":"p","c":["Your first ",{"t":"code","v":"p"}," element should introduce the travel opportunities."]}],"test":"assert.isNotEmpty(document.querySelector('p')?.textContent?.trim());"},{"text":[{"t":"p","c":["Your first ",{"t":"code","v":"h2"}," element should have the text ",{"t":"code","v":"Packages"},"."]}],"test":"assert.equal(document.querySelectorAll('h2')[0]?.innerText.trim(), 'Packages');"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"p"}," element below your first ",{"t":"code","v":"h2"}," element."]}],"test":"assert.strictEqual(\n    document.querySelector('h2')?.nextElementSibling.tagName, 'P'\n);"},{"text":[{"t":"p","c":["Your second ",{"t":"code","v":"p"}," element should introduce briefly the various packages."]}],"test":"assert.isNotEmpty(document.querySelectorAll('p')?.[1]?.textContent?.trim());"},{"text":[{"t":"p","c":["You should have an unordered list element below your second ",{"t":"code","v":"p"}," element."]}],"test":"assert.strictEqual(\n  document.querySelectorAll('p')?.[1]?.nextElementSibling?.tagName,\n  'UL'\n);"},{"text":[{"t":"p","c":["You should have two items in your unordered list."]}],"test":"assert.lengthOf(document.querySelectorAll('p + ul li'), 2);"},{"text":[{"t":"p","c":["Both your list items should contain an anchor element."]}],"test":"const listItems = document.querySelectorAll('p + ul li');\nassert.isNotEmpty(listItems);\nfor (let e of listItems) {\n  assert.strictEqual(e.children[0].tagName, 'A');\n  assert.lengthOf(e.children, 1);\n}"},{"text":[{"t":"p","c":["The anchor element of your first list item should wrap the text ",{"t":"code","v":"Group Travels"},"."]}],"test":"assert.equal(document.querySelectorAll('li > a')[0]?.innerText.trim(), 'Group Travels');"},{"text":[{"t":"p","c":["The anchor element of your second list item should wrap the text ",{"t":"code","v":"Private Tours"},"."]}],"test":"assert.equal(document.querySelectorAll('li > a')[1]?.innerText.trim(), 'Private Tours');"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"h2"}," element after your unordered list."]}],"test":"assert.strictEqual(\n  document.querySelectorAll('h2')[1]?.previousElementSibling.tagName,\n  'UL'\n);"},{"text":[{"t":"p","c":["Your second ",{"t":"code","v":"h2"}," element should have the text ",{"t":"code","v":"Top Itineraries"},"."]}],"test":"assert.equal(document.querySelectorAll('h2')[1]?.innerText.trim(), 'Top Itineraries');"},{"text":[{"t":"p","c":["You should have at least three ",{"t":"code","v":"figure"}," elements."]}],"test":"assert.isAtLeast(document.querySelectorAll('figure').length, 3);"},{"text":[{"t":"p","c":["Each ",{"t":"code","v":"figure"}," element should contain an anchor element as its first nested element."]}],"test":"const figures = document.querySelectorAll('figure');\nassert.isNotEmpty(figures);\nfor (let figure of figures) {\n  assert.equal(figure.children[0].tagName, 'A');\n}"},{"text":[{"t":"p","c":["Each ",{"t":"code","v":"figure"}," element should contain a ",{"t":"code","v":"figcaption"}," element as its second nested element."]}],"test":"const figures = document.querySelectorAll('figure');\nassert.isNotEmpty(figures);\nfor (let figure of figures) {\n  assert.equal(figure.children[1]?.tagName, 'FIGCAPTION');\n}"},{"text":[{"t":"p","c":["Each ",{"t":"code","v":"figcaption"}," should contain some text."]}],"test":"const figcaptionEls = document.querySelectorAll('figcaption');\nassert.isNotEmpty(figcaptionEls);\nfigcaptionEls.forEach((figcaption => assert.isNotEmpty(figcaption.innerText)));"},{"text":[{"t":"p","c":["Each of the ",{"t":"code","v":"a"}," elements nested in your ",{"t":"code","v":"figure"}," elements should contain an image."]}],"test":"const anchors = document.querySelectorAll('figure > a');\nassert.isNotEmpty(anchors);\nfor (let anchor of anchors) {\n  assert.equal(anchor.children[0]?.tagName, 'IMG');\n}"},{"text":[{"t":"p","c":["Each ",{"t":"code","v":"img"}," element should have a valid ",{"t":"code","v":"src"}," attribute."]}],"test":"const images = document.querySelectorAll('img');\nassert.isNotEmpty(images);\nfor (let image of images) {\n  assert.isAbove(image.src.trim().length, 0);\n}"},{"text":[{"t":"p","c":["Each ",{"t":"code","v":"img"}," element should have an ",{"t":"code","v":"alt"}," attribute with an appropriate value."]}],"test":"const images = document.querySelectorAll('img');\nassert.isNotEmpty(images);\nfor (let image of images) {\n  assert.isAbove(image.alt.trim().length, 0);\n}"},{"text":[{"t":"p","c":["Each ",{"t":"code","v":"a"}," element should have an ",{"t":"code","v":"href"}," attribute with the value of ",{"t":"code","v":"https://www.freecodecamp.org/learn"},". Don't forget the links in the list items."]}],"test":"const anchors = document.querySelectorAll('a');\nassert.isNotEmpty(anchors);\nfor (let anchor of anchors) {\n  assert.equal(anchor.href, 'https://www.freecodecamp.org/learn');\n}"},{"text":[{"t":"p","c":["Each ",{"t":"code","v":"a"}," element should have a ",{"t":"code","v":"target"}," attribute with the value of ",{"t":"code","v":"_blank"},". Don't forget the links in the list items."]}],"test":"const anchors = document.querySelectorAll('a');\nassert.isNotEmpty(anchors);\nfor (let anchor of anchors) {\n  assert.equal(anchor.target, '_blank');\n}"}],"seed":{"files":[{"lang":"html","contents":""}]},"solutions":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>Travel Agency Page</title>\n    <meta name=\"description\" content=\"This is an example website.\"/>\n  </head>\n  <body>\n    <h1>Discover Italy</h1>\n    <p>\n      Art, folklore, food, nature, and more. Choose among our wide selection of\n      guided tours and excursions, and live an unforgettable experience\n      exploring Italy.\n    </p>\n    <h2>Packages</h2>\n    <p>\n      We offer an extensive range of holiday solutions to accommodate the needs\n      of all our clients. From daily excursions in the most beautiful cities, to\n      thorough tours of hidden villages and medieval towns to discover Italy's\n      lesser-known sides.\n    </p>\n    <ul>\n      <li>\n        <a href=\"https://www.freecodecamp.org/learn\" target=\"_blank\"\n          >Group Travels</a\n        >\n      </li>\n      <li>\n        <a href=\"https://www.freecodecamp.org/learn\" target=\"_blank\"\n          >Private Tours</a\n        >\n      </li>\n    </ul>\n    <h2>Top Itineraries</h2>\n    <figure>\n      <a href=\"https://www.freecodecamp.org/learn\" target=\"_blank\">\n        <img\n          src=\"https://cdn.freecodecamp.org/curriculum/labs/colosseo.jpg\"\n          alt=\"colosseum view\"\n        />\n      </a>\n      <figcaption>Rome and Center Italy</figcaption>\n    </figure>\n    <figure>\n      <a href=\"https://www.freecodecamp.org/learn\" target=\"_blank\">\n        <img\n          src=\"https://cdn.freecodecamp.org/curriculum/labs/alps.jpg\"\n          alt=\"dolomites mountain view\"\n        />\n      </a>\n      <figcaption>Nature and National Parks</figcaption>\n    </figure>\n    <figure>\n      <a href=\"https://www.freecodecamp.org/learn\" target=\"_blank\">\n        <img\n          src=\"https://cdn.freecodecamp.org/curriculum/labs/sea.jpg\"\n          alt=\"sea view\"\n        />\n      </a>\n      <figcaption>South Italy and Islands</figcaption>\n    </figure>\n  </body>\n</html>"}]}]}