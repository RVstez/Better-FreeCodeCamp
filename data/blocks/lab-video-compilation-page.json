{"name":"lab-video-compilation-page","kind":"lab","layout":"link","multifile":true,"editableBoundaries":false,"helpCategory":"HTML-CSS","challenges":[{"id":"669e81368e52b3a5c35a2dc5","title":"Build a Video Compilation Page","dashedName":"build-a-video-compilation-page","challengeType":25,"demoType":"onClick","description":[{"t":"p","c":[{"t":"strong","c":["Objective:"]}," Fulfill the user stories below and get all the tests to pass to complete the lab."]},{"t":"p","c":[{"t":"strong","c":["User Stories:"]}]},{"t":"ol","items":[[{"t":"p","c":["You should have a ",{"t":"code","v":"main"}," element as the only child of the ",{"t":"code","v":"body"}," element."]}],[{"t":"p","c":["You should have an ",{"t":"code","v":"h1"}," element with the topic of your page."]}],[{"t":"p","c":["You should have a paragraph introducing the topic of your page below your ",{"t":"code","v":"h1"}," element."]}],[{"t":"p","c":["You should have three ",{"t":"code","v":"section"}," elements below your first paragraph."]}],[{"t":"p","c":["Each section should contain an ",{"t":"code","v":"h2"}," element, a paragraph, and an ",{"t":"code","v":"iframe"}," element, in this order."]}],[{"t":"p","c":["The three ",{"t":"code","v":"iframe"}," elements should have a ",{"t":"code","v":"src"}," attribute set to a valid video."]}],[{"t":"p","c":["Each ",{"t":"code","v":"iframe"}," element should also have a ",{"t":"code","v":"title"}," attribute to describe the embedded content, and a ",{"t":"code","v":"height"}," attribute and a ",{"t":"code","v":"width"}," attribute to set the element to a proper size."]}]]}],"hints":[{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"main"}," element inside your ",{"t":"code","v":"body"}," element."]}],"test":"assert.equal(document.querySelector('body :first-child').tagName, 'MAIN');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"main"}," element should be the only child of the ",{"t":"code","v":"body"}," element."]}],"test":"assert.equal(document.querySelector('body').children.length, 1);"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"h1"}," element with the topic of your page inside the ",{"t":"code","v":"main"}," element."]}],"test":"assert.isAbove(document.querySelector('h1')?.innerText.length, 0);"},{"text":[{"t":"p","c":["You should have a paragraph introducing the topic of your page below your ",{"t":"code","v":"h1"}," element."]}],"test":"const p = document.querySelectorAll('p')[0];\nassert.equal(p?.previousElementSibling?.tagName, 'H1');\nassert.isAbove(p?.innerText.length, 0);"},{"text":[{"t":"p","c":["You should have three ",{"t":"code","v":"section"}," elements below your first ",{"t":"code","v":"p"}," element."]}],"test":"assert.equal(document.querySelectorAll('section')?.length, 3);\nassert.equal(document.querySelectorAll('section')[0]?.previousElementSibling?.tagName, 'P')"},{"text":[{"t":"p","c":["Each ",{"t":"code","v":"section"}," element should start with an ",{"t":"code","v":"h2"}," element that serves as the title for that section."]}],"test":"const sections = document.querySelectorAll('section');\nassert.equal(sections?.length, 3)\nfor (let section of sections) {\n    assert.equal(section.children[0]?.tagName, 'H2');\n    assert.isAbove(section.children[0]?.innerText.length, 0);\n}"},{"text":[{"t":"p","c":["Each ",{"t":"code","v":"section"}," element should contain a ",{"t":"code","v":"p"}," element to introduce the video content as its second child."]}],"test":"const sections = document.querySelectorAll('section');\nassert.equal(sections?.length, 3)\nfor (let section of sections) {\n    assert.equal(section.children[1]?.tagName, 'P');\n    assert.isAbove(section.children[1]?.innerText.length, 0);\n}"},{"text":[{"t":"p","c":["Each ",{"t":"code","v":"section"}," element should contain an ",{"t":"code","v":"iframe"}," element as its third child."]}],"test":"const sections = document.querySelectorAll('section');\nassert.equal(sections?.length, 3)\nfor (let section of sections) {\n    assert.equal(section.children[2]?.tagName, 'IFRAME');\n}"},{"text":[{"t":"p","c":["Your first ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"src"}," attribute set to a valid video."]}],"test":"assert.isAbove(document.querySelectorAll('iframe')[0]?.src.length, 0)"},{"text":[{"t":"p","c":["Your first ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"title"}," attribute to describe the embedded content."]}],"test":"assert.isAbove(document.querySelectorAll('iframe')[0]?.title.length, 0)"},{"text":[{"t":"p","c":["Your first ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"height"}," attribute."]}],"test":"assert.isAbove(document.querySelectorAll('iframe')[0]?.height.length, 0)"},{"text":[{"t":"p","c":["Your first ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"width"}," attribute."]}],"test":"assert.isAbove(document.querySelectorAll('iframe')[0]?.width.length, 0)"},{"text":[{"t":"p","c":["Your second ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"src"}," attribute set to a valid video."]}],"test":"assert.isAbove(document.querySelectorAll('iframe')[1]?.src.length, 0)"},{"text":[{"t":"p","c":["Your second ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"title"}," attribute to describe the embedded content."]}],"test":"assert.isAbove(document.querySelectorAll('iframe')[1]?.title.length, 0)"},{"text":[{"t":"p","c":["Your second ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"height"}," attribute."]}],"test":"assert.isAbove(document.querySelectorAll('iframe')[1]?.height.length, 0)"},{"text":[{"t":"p","c":["Your second ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"width"}," attribute."]}],"test":"assert.isAbove(document.querySelectorAll('iframe')[1]?.width.length, 0)"},{"text":[{"t":"p","c":["Your third ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"src"}," attribute set to a valid video."]}],"test":"assert.isAbove(document.querySelectorAll('iframe')[2]?.src.length, 0)"},{"text":[{"t":"p","c":["Your third ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"title"}," attribute to describe the embedded content."]}],"test":"assert.isAbove(document.querySelectorAll('iframe')[2]?.title.length, 0)"},{"text":[{"t":"p","c":["Your third ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"height"}," attribute."]}],"test":"assert.isAbove(document.querySelectorAll('iframe')[2]?.height.length, 0)"},{"text":[{"t":"p","c":["Your third ",{"t":"code","v":"iframe"}," element should have a ",{"t":"code","v":"width"}," attribute."]}],"test":"assert.isAbove(document.querySelectorAll('iframe')[2]?.width.length, 0)"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <title>Video Compilation Page</title>\n</head>\n\n<body>\n\n</body>\n\n</html>"}]},"solutions":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <title>Video Compilation Page</title>\n</head>\n\n<body>\n    <main>\n        <h1>Front-End Web Development</h1>\n        <p>Front-End Web Development involves designing and building user interfaces of websites using HTML, CSS, and\n            JavaScript. It focuses on creating visually appealing, interactive, and user-friendly websites. Front-end\n            developers ensure accessibility, performance optimization, and\n            adherence to web standards, blending creativity with technical expertise.</p>\n        <section>\n            <h2>HTML</h2>\n            <p>HTML, or HyperText Markup Language, forms the backbone of web pages by defining their basic structure and\n                layout. It uses a series of elements to display text, images, lists, tables, and other static content on\n                a web page.</p>\n            <iframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/GDGejH3SDNQ?si=KJYLgcz4kyyroYMB\"\n                title=\"html and coding introduction video\" frameborder=\"0\"\n                allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n                referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>\n        </section>\n        <section>\n            <h2>CSS</h2>\n            <p>CSS, or Cascading Style Sheets, is used to control the visual presentation of HTML elements on a web\n                page. It allows for customized styling, including colors, fonts, layouts, and spacing, making websites\n                visually appealing. CSS also supports responsive design, ensuring web pages look good on\n                all devices.</p>\n            <iframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/OXGznpKZ_sA?si=s3KDSZvrhU_PU9XL\"\n                title=\"css tutorial video\" frameborder=\"0\"\n                allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n                referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>\n        </section>\n        <section>\n            <h2>JavaScript</h2>\n            <p>JavaScript is a programming language that adds interactivity to static web pages, enabling dynamic\n                content updates, form validations, animations, and responsive behaviors based on user interactions and\n                events.</p>\n            <iframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/jS4aFq5-91M?si=zKQhHEYwU4tnMmVm\"\n                title=\"javascript programming video\" frameborder=\"0\"\n                allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n                referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>\n        </section>\n    </main>\n</body>\n\n</html>"}]}]}