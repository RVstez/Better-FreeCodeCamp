{"name":"lab-survey-form","kind":"lab","layout":"link","multifile":true,"editableBoundaries":false,"helpCategory":"HTML-CSS","challenges":[{"id":"587d78af367417b2b2512b03","title":"Build a Survey Form","dashedName":"build-a-survey-form","challengeType":25,"demoType":"onClick","saveSubmissionToDB":true,"description":[{"t":"p","c":[{"t":"strong","c":["Objective:"]}," Fulfill the user stories below and get all the tests to pass to complete the lab."]},{"t":"p","c":[{"t":"strong","c":["User Stories:"]}]},{"t":"ol","items":[[{"t":"p","c":["You should have a page title in an ",{"t":"code","v":"h1"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"title"},"."]}],[{"t":"p","c":["You should have a short explanation in a ",{"t":"code","v":"p"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"description"},"."]}],[{"t":"p","c":["You should have a ",{"t":"code","v":"form"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"survey-form"},"."]}],[{"t":"p","c":["Inside the form element you should have a required ",{"t":"code","v":"input"}," field to enter your name that has an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"name"}," and a ",{"t":"code","v":"type"}," of ",{"t":"code","v":"text"},"."]}],[{"t":"p","c":["Inside the form element you should have a required ",{"t":"code","v":"input"}," field to enter your email that has an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"email"},"."]}],[{"t":"p","c":["If you enter an email that is not formatted correctly, you should see an HTML5 validation error."]}],[{"t":"p","c":["Inside the form element you should have an ",{"t":"code","v":"input"}," field to enter a number that has an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"number"},"."]}],[{"t":"p","c":["The number input should not accept non-numbers, either by preventing you from typing them or by showing an HTML5 validation error (depending on your browser)."]}],[{"t":"p","c":["If you enter numbers outside the range of the number input, which are defined by the ",{"t":"code","v":"min"}," and ",{"t":"code","v":"max"}," attributes, you should see an HTML5 validation error."]}],[{"t":"p","c":["For the name, email, and number input fields, you should have corresponding ",{"t":"code","v":"label"}," elements in the form, that describe the purpose of each field with the following ids: ",{"t":"code","v":"name-label"},", ",{"t":"code","v":"email-label"},", and ",{"t":"code","v":"number-label"},"."]}],[{"t":"p","c":["For the name, email, and number input fields, you should have a placeholder text that gives a description or instructions for each field."]}],[{"t":"p","c":["Inside the form element, you should have a ",{"t":"code","v":"select"}," dropdown element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"dropdown"}," and at least two options to choose from."]}],[{"t":"p","c":["Inside the form element, you can select an option from a group of at least two radio buttons that are grouped using the ",{"t":"code","v":"name"}," attribute."]}],[{"t":"p","c":["Inside the form element, you can select several fields from a series of checkboxes, each of which must have a ",{"t":"code","v":"value"}," attribute."]}],[{"t":"p","c":["Inside the form element, you should have a ",{"t":"code","v":"textarea"}," for additional comments."]}],[{"t":"p","c":["Inside the form element, you should have a button with ",{"t":"code","v":"id"}," of ",{"t":"code","v":"submit"}," to submit all the inputs."]}]]}],"hints":[{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"h1"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"title"},"."]}],"test":"const el = document.getElementById('title');\nassert.isNotNull(el);\nassert.strictEqual(el.tagName, 'H1');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#title"}," should not be empty."]}],"test":"const el = document.getElementById('title');\nassert.isNotNull(el);\nassert.isAbove(el.innerText.length, 0);"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"p"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"description"},"."]}],"test":"const el = document.getElementById('description');\nassert.isNotNull(el);\nassert.strictEqual(el.tagName, 'P');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#description"}," should not be empty."]}],"test":"const el = document.getElementById('description');\nassert.isNotNull(el);\nassert.isAbove(el.innerText.length, 0);"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"form"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"survey-form"},"."]}],"test":"const el = document.getElementById('survey-form');\nassert.isNotNull(el);\nassert.strictEqual(el.tagName, 'FORM');"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"input"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"name"},"."]}],"test":"const el = document.getElementById('name');\nassert.isNotNull(el);\nassert.strictEqual(el.tagName, 'INPUT');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#name"}," should have a ",{"t":"code","v":"type"}," of ",{"t":"code","v":"text"},"."]}],"test":"const el = document.getElementById('name');\nassert.isNotNull(el);\nassert.strictEqual(el.type, 'text');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#name"}," should require input."]}],"test":"const el = document.getElementById('name');\nassert.isNotNull(el);\nassert.isTrue(el.required);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#name"}," should be a descendant of ",{"t":"code","v":"#survey-form"},"."]}],"test":"const el = document.querySelector('#survey-form #name');\nassert.isNotNull(el);"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"input"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"email"},"."]}],"test":"const el = document.getElementById('email');\nassert.isNotNull(el);\nassert.strictEqual(el.tagName, 'INPUT');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#email"}," should have a ",{"t":"code","v":"type"}," of ",{"t":"code","v":"email"},"."]}],"test":"const el = document.getElementById('email');\nassert.isNotNull(el);\nassert.strictEqual(el.type, 'email');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#email"}," should require input."]}],"test":"const el = document.getElementById('email');\nassert.isNotNull(el);\nassert.isTrue(el.required);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#email"}," should be a descendant of ",{"t":"code","v":"#survey-form"},"."]}],"test":"const el = document.querySelector('#survey-form #email');\nassert.isNotNull(el);"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"input"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"number"},"."]}],"test":"const el = document.getElementById('number');\nassert.isNotNull(el);\nassert.strictEqual(el.tagName, 'INPUT');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#number"}," should be a descendant of ",{"t":"code","v":"#survey-form"},"."]}],"test":"const el = document.querySelector('#survey-form #number');\nassert.isNotNull(el);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#number"}," should have a ",{"t":"code","v":"type"}," of ",{"t":"code","v":"number"},"."]}],"test":"const el = document.getElementById('number');\nassert.isNotNull(el);\nassert.strictEqual(el.type, 'number');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#number"}," should have a ",{"t":"code","v":"min"}," attribute with a numeric value."]}],"test":"const el = document.getElementById('number');\nassert.isNotNull(el);\nassert.isNotEmpty(el.min);\nassert.isTrue(isFinite(el.min));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#number"}," should have a ",{"t":"code","v":"max"}," attribute with a numeric value."]}],"test":"const el = document.getElementById('number');\nassert.isNotNull(el);\nassert.isNotEmpty(el.max);\nassert.isTrue(isFinite(el.max));"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"label"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"name-label"},"."]}],"test":"const el = document.getElementById('name-label');\nassert.isNotNull(el);\nassert.strictEqual(el.tagName, 'LABEL');"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"label"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"email-label"},"."]}],"test":"const el = document.getElementById('email-label');\nassert.isNotNull(el);\nassert.strictEqual(el.tagName, 'LABEL');"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"label"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"number-label"},"."]}],"test":"const el = document.getElementById('number-label');\nassert.isNotNull(el);\nassert.strictEqual(el.tagName, 'LABEL');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#name-label"}," should contain text that describes the input."]}],"test":"const el = document.getElementById('name-label');\nassert.isNotNull(el);\nassert.isAbove(el.innerText.length, 0);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#email-label"}," should contain text that describes the input."]}],"test":"const el = document.getElementById('email-label');\nassert.isNotNull(el);\nassert.isAbove(el.innerText.length, 0);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#number-label"}," should contain text that describes the input."]}],"test":"const el = document.getElementById('number-label');\nassert.isNotNull(el);\nassert.isAbove(el.innerText.length, 0);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#name-label"}," should be a descendant of ",{"t":"code","v":"#survey-form"},"."]}],"test":"const el = document.querySelector('#survey-form #name-label');\nassert.isNotNull(el);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#email-label"}," should be a descendant of ",{"t":"code","v":"#survey-form"},"."]}],"test":"const el = document.querySelector('#survey-form #email-label');\nassert.isNotNull(el);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#number-label"}," should be a descendant of ",{"t":"code","v":"#survey-form"},"."]}],"test":"const el = document.querySelector('#survey-form #number-label');\nassert.isNotNull(el);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#name"}," should have a ",{"t":"code","v":"placeholder"}," attribute and value."]}],"test":"const el = document.getElementById('name');\nassert.isNotNull(el);\nassert.isNotNull(el.placeholder);\nassert.isAbove(el.placeholder.length, 0);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#email"}," should have a ",{"t":"code","v":"placeholder"}," attribute and value."]}],"test":"const el = document.getElementById('email');\nassert.isNotNull(el);\nassert.isNotNull(el.placeholder);\nassert.isAbove(el.placeholder.length, 0);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#number"}," should have a ",{"t":"code","v":"placeholder"}," attribute and value."]}],"test":"const el = document.getElementById('number');\nassert.isNotNull(el);\nassert.isNotNull(el.placeholder);\nassert.isAbove(el.placeholder.length, 0);"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"select"}," field with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"dropdown"},"."]}],"test":"const el = document.getElementById('dropdown');\nassert.isNotNull(el);\nassert.strictEqual(el.tagName, 'SELECT');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#dropdown"}," should have at least two selectable (not disabled) ",{"t":"code","v":"option"}," elements."]}],"test":"const els = document.querySelectorAll('#dropdown option:not([disabled])');\nassert.isAtLeast(els.length, 2);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#dropdown"}," should be a descendant of ",{"t":"code","v":"#survey-form"},"."]}],"test":"const el = document.querySelector('#survey-form #dropdown');\nassert.isNotNull(el);"},{"text":[{"t":"p","c":["You should have at least two ",{"t":"code","v":"input"}," elements with a ",{"t":"code","v":"type"}," of ",{"t":"code","v":"radio"}," (radio buttons)."]}],"test":"const els = document.querySelectorAll('input[type=\"radio\"]');\nassert.isAtLeast(els.length, 2);"},{"text":[{"t":"p","c":["You should have at least two radio buttons that are descendants of ",{"t":"code","v":"#survey-form"},"."]}],"test":"const els = document.querySelectorAll('#survey-form input[type=\"radio\"]');\nassert.isAtLeast(els.length, 2);"},{"text":[{"t":"p","c":["All your radio buttons should have a ",{"t":"code","v":"value"}," attribute and value."]}],"test":"const els1 = document.querySelectorAll('input[type=\"radio\"]');\nconst els2 = document.querySelectorAll(\n  'input[type=\"radio\"][value=\"\"], input[type=\"radio\"]:not([value])'\n);\nassert.isAbove(els1.length, 0);\nassert.lengthOf(els2, 0);"},{"text":[{"t":"p","c":["All your radio buttons should have a ",{"t":"code","v":"name"}," attribute and value."]}],"test":"const els1 = document.querySelectorAll('input[type=\"radio\"]');\nconst els2 = document.querySelectorAll(\n  'input[type=\"radio\"][name=\"\"], input[type=\"radio\"]:not([name])'\n);\nassert.isAbove(els1.length, 0);\nassert.lengthOf(els2, 0);"},{"text":[{"t":"p","c":["Every radio button group should have at least 2 radio buttons."]}],"test":"const radioButtons = document.querySelectorAll('input[type=\"radio\"]');\nconst groups = {};\n\nif (radioButtons) {\n  radioButtons.forEach(el => {\n    if (!groups[el.name]) groups[el.name] = [];\n    groups[el.name].push(el);\n  });\n}\n\nconst groupKeys = Object.keys(groups);\n\ngroupKeys.forEach(key => {\n  if (groups[key].length < 2) assert.fail();\n});\n\nassert.isAbove(groupKeys.length, 0);"},{"text":[{"t":"p","c":["You should have at least two ",{"t":"code","v":"input"}," elements with a ",{"t":"code","v":"type"}," of ",{"t":"code","v":"checkbox"}," (checkboxes) that are descendants of ",{"t":"code","v":"#survey-form"},"."]}],"test":"const els = document.querySelectorAll('#survey-form input[type=\"checkbox\"]');\nassert.isAtLeast(els.length, 2);"},{"text":[{"t":"p","c":["All your checkboxes inside ",{"t":"code","v":"#survey-form"}," should have a ",{"t":"code","v":"value"}," attribute and value."]}],"test":"const els1 = document.querySelectorAll('#survey-form input[type=\"checkbox\"]');\nconst els2 = document.querySelectorAll(\n  '#survey-form input[type=\"checkbox\"][value=\"\"], #survey-form input[type=\"checkbox\"]:not([value])'\n);\nassert.isAbove(els1.length, 0);\nassert.lengthOf(els2, 0);"},{"text":[{"t":"p","c":["You should have at least one ",{"t":"code","v":"textarea"}," element that is a descendant of ",{"t":"code","v":"#survey-form"},"."]}],"test":"const el = document.querySelector('#survey-form textarea');\nassert.isNotNull(el);"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"input"}," or ",{"t":"code","v":"button"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"submit"},"."]}],"test":"const el = document.getElementById('submit');\nassert.isNotNull(el);\nassert.isTrue(el.tagName === 'INPUT' || el.tagName === 'BUTTON');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#submit"}," should have a ",{"t":"code","v":"type"}," of ",{"t":"code","v":"submit"},"."]}],"test":"const el = document.getElementById('submit');\nassert.isNotNull(el);\nassert.strictEqual(el.type, 'submit');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#submit"}," should be a descendant of ",{"t":"code","v":"#survey-form"},"."]}],"test":"const el = document.querySelector('#survey-form #submit');\nassert.isNotNull(el);"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Survey Form</title>\n  </head>\n\n  <body></body>\n</html>"}]},"solutions":[{"lang":"html","contents":"<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"styles.css\" />\n  </head>\n  <body>\n    <div class=\"container\">\n      <header class=\"header\">\n        <h1 id=\"title\" class=\"text-center\">freeCodeCamp Survey Form</h1>\n        <p id=\"description\" class=\"description text-center\">\n          Thank you for taking the time to help us improve the platform\n        </p>\n      </header>\n      <form id=\"survey-form\">\n        <div class=\"form-group\">\n          <label id=\"name-label\" for=\"name\">Name</label>\n          <input\n            type=\"text\"\n            name=\"name\"\n            id=\"name\"\n            class=\"form-control\"\n            placeholder=\"Enter your name\"\n            required\n          />\n        </div>\n        <div class=\"form-group\">\n          <label id=\"email-label\" for=\"email\">Email</label>\n          <input\n            type=\"email\"\n            name=\"email\"\n            id=\"email\"\n            class=\"form-control\"\n            placeholder=\"Enter your Email\"\n            required\n          />\n        </div>\n        <div class=\"form-group\">\n          <label id=\"number-label\" for=\"number\"\n            >Age<span class=\"clue\">(optional)</span></label\n          >\n          <input\n            type=\"number\"\n            name=\"age\"\n            id=\"number\"\n            min=\"10\"\n            max=\"99\"\n            class=\"form-control\"\n            placeholder=\"Age\"\n          />\n        </div>\n        <div class=\"form-group\">\n          <p>Which option best describes your current role?</p>\n          <select id=\"dropdown\" name=\"role\" class=\"form-control\" required>\n            <option disabled selected value>Select current role</option>\n            <option value=\"student\">Student</option>\n            <option value=\"job\">Full Time Job</option>\n            <option value=\"learner\">Full Time Learner</option>\n            <option value=\"preferNo\">Prefer not to say</option>\n            <option value=\"other\">Other</option>\n          </select>\n        </div>\n\n        <div class=\"form-group\">\n          <p>Would you recommend freeCodeCamp to a friend?</p>\n          <label>\n            <input\n              name=\"user-recommend\"\n              value=\"definitely\"\n              type=\"radio\"\n              class=\"input-radio\"\n              checked\n            />Definitely</label\n          >\n          <label>\n            <input\n              name=\"user-recommend\"\n              value=\"maybe\"\n              type=\"radio\"\n              class=\"input-radio\"\n            />Maybe</label\n          >\n\n          <label\n            ><input\n              name=\"user-recommend\"\n              value=\"not-sure\"\n              type=\"radio\"\n              class=\"input-radio\"\n            />Not sure</label\n          >\n        </div>\n\n        <div class=\"form-group\">\n          <p>What is your favorite feature of freeCodeCamp?</p>\n          <select id=\"most-like\" name=\"mostLike\" class=\"form-control\" required>\n            <option disabled selected value>Select an option</option>\n            <option value=\"challenges\">Challenges</option>\n            <option value=\"projects\">Projects</option>\n            <option value=\"community\">Community</option>\n            <option value=\"openSource\">Open Source</option>\n          </select>\n        </div>\n\n        <div class=\"form-group\">\n          <p>\n            What would you like to see improved?\n            <span class=\"clue\">(Check all that apply)</span>\n          </p>\n\n          <label\n            ><input\n              name=\"prefer\"\n              value=\"front-end-projects\"\n              type=\"checkbox\"\n              class=\"input-checkbox\"\n            />Front-end Projects</label\n          >\n          <label>\n            <input\n              name=\"prefer\"\n              value=\"back-end-projects\"\n              type=\"checkbox\"\n              class=\"input-checkbox\"\n            />Back-end Projects</label\n          >\n          <label\n            ><input\n              name=\"prefer\"\n              value=\"data-visualization\"\n              type=\"checkbox\"\n              class=\"input-checkbox\"\n            />Data Visualization</label\n          >\n          <label\n            ><input\n              name=\"prefer\"\n              value=\"challenges\"\n              type=\"checkbox\"\n              class=\"input-checkbox\"\n            />Challenges</label\n          >\n          <label\n            ><input\n              name=\"prefer\"\n              value=\"open-source-community\"\n              type=\"checkbox\"\n              class=\"input-checkbox\"\n            />Open Source Community</label\n          >\n          <label\n            ><input\n              name=\"prefer\"\n              value=\"gitter-help-rooms\"\n              type=\"checkbox\"\n              class=\"input-checkbox\"\n            />Gitter help rooms</label\n          >\n          <label\n            ><input\n              name=\"prefer\"\n              value=\"videos\"\n              type=\"checkbox\"\n              class=\"input-checkbox\"\n            />Videos</label\n          >\n          <label\n            ><input\n              name=\"prefer\"\n              value=\"city-meetups\"\n              type=\"checkbox\"\n              class=\"input-checkbox\"\n            />City Meetups</label\n          >\n          <label\n            ><input\n              name=\"prefer\"\n              value=\"wiki\"\n              type=\"checkbox\"\n              class=\"input-checkbox\"\n            />Wiki</label\n          >\n          <label\n            ><input\n              name=\"prefer\"\n              value=\"forum\"\n              type=\"checkbox\"\n              class=\"input-checkbox\"\n            />Forum</label\n          >\n          <label\n            ><input\n              name=\"prefer\"\n              value=\"additional-courses\"\n              type=\"checkbox\"\n              class=\"input-checkbox\"\n            />Additional Courses</label\n          >\n        </div>\n\n        <div class=\"form-group\">\n          <p>Any comments or suggestions?</p>\n          <textarea\n            id=\"comments\"\n            class=\"input-textarea\"\n            name=\"comment\"\n            placeholder=\"Enter your comment here...\"\n          ></textarea>\n        </div>\n\n        <div class=\"form-group\">\n          <button type=\"submit\" id=\"submit\" class=\"submit-button\">\n            Submit\n          </button>\n        </div>\n      </form>\n    </div>\n  </body>\n</html>"}]}]}