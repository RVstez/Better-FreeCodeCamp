{"name":"lab-checkout-page","kind":"lab","layout":"link","multifile":true,"editableBoundaries":false,"helpCategory":"HTML-CSS","challenges":[{"id":"66da326c02141df538f29ba5","title":"Build a Checkout Page","dashedName":"build-a-checkout-page","challengeType":25,"demoType":"onClick","description":[{"t":"p","c":[{"t":"strong","c":["Objective:"]}," Fulfill the user stories below and get all the tests to pass to complete the lab."]},{"t":"p","c":[{"t":"strong","c":["User Stories:"]}]},{"t":"ol","items":[[{"t":"p","c":["You should have an ",{"t":"code","v":"h1"}," element with the text ",{"t":"code","v":"Checkout"},"."]}],[{"t":"p","c":["You should have two ",{"t":"code","v":"section"}," elements immediately after the ",{"t":"code","v":"h1"}," element."]}],[{"t":"p","c":["You should have an ",{"t":"code","v":"h2"}," element with the text ",{"t":"code","v":"Your Cart"}," within the first section."]}],[{"t":"p","c":["You should have an image of an item in the first section with appropriate alternate text. You can use this image if you would like: ",{"t":"code","v":"https://cdn.freecodecamp.org/curriculum/labs/cube.jpg"}]}],[{"t":"p","c":["You should have an ",{"t":"code","v":"h2"}," element with the text ",{"t":"code","v":"Payment Information"}," within the second section."]}],[{"t":"p","c":["You should have a ",{"t":"code","v":"form"}," element within the second section."]}],[{"t":"p","c":["You should have an input with an ",{"t":"code","v":"id"}," and ",{"t":"code","v":"name"}," of ",{"t":"code","v":"card-name"},", and a ",{"t":"code","v":"type"}," of ",{"t":"code","v":"text"}," within your form and a ",{"t":"code","v":"label"}," associated with it."]}],[{"t":"p","c":["You should have an input with an ",{"t":"code","v":"id"}," and ",{"t":"code","v":"name"}," of ",{"t":"code","v":"card-number"},", and a ",{"t":"code","v":"type"}," of ",{"t":"code","v":"text"}," within your form and a ",{"t":"code","v":"label"}," associated with it."]}],[{"t":"p","c":["You should have at least two ",{"t":"code","v":"input"}," elements with the ",{"t":"code","v":"required"}," attribute."]}],[{"t":"p","c":["You should include a ",{"t":"code","v":"span"}," element with the text ",{"t":"code","v":"*"}," and ",{"t":"code","v":"aria-hidden"}," set to ",{"t":"code","v":"true"}," inside the ",{"t":"code","v":"label"}," element for each required input, so that required fields are visually indicated."]}],[{"t":"p","c":["You should have a ",{"t":"code","v":"p"}," element with a help text that explains the required card number format, placed immediately after the card number input. The ",{"t":"code","v":"p"}," should have an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"card-number-help"}," and be referenced by the card number input using ",{"t":"code","v":"aria-describedby"},"."]}]]}],"hints":[{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"h1"}," element with the text ",{"t":"code","v":"Checkout"},"."]}],"test":"assert.equal(document.querySelector('h1')?.innerText, 'Checkout');"},{"text":[{"t":"p","c":["You should only have one ",{"t":"code","v":"h1"}," element on your page."]}],"test":"assert.lengthOf(document.querySelectorAll('h1'), 1);"},{"text":[{"t":"p","c":["You should have at least two ",{"t":"code","v":"section"}," elements after the ",{"t":"code","v":"h1"}," element."]}],"test":"const h1 = document.querySelector('h1');\nconst firstSibling = h1?.nextElementSibling;\nconst secondSibling = firstSibling?.nextElementSibling;\nassert.equal(firstSibling?.tagName, 'SECTION');\nassert.equal(secondSibling?.tagName, 'SECTION');"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"h2"}," element with the text ",{"t":"code","v":"Your Cart"}," within the first section."]}],"test":"const firstSection = document.querySelectorAll('section')?.[0];\nassert.equal(firstSection?.querySelector('h2')?.innerText, 'Your Cart');"},{"text":[{"t":"p","c":["You should have at least one image with alternate text in your first section."]}],"test":"const firstSection = document.querySelectorAll('section')?.[0];\nassert.isAtLeast(firstSection?.querySelector('img')?.alt?.length, 1);"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"h2"}," element with the text ",{"t":"code","v":"Payment Information"}," within the second section."]}],"test":"const secondSection = document.querySelectorAll('section')?.[1];\nassert.equal(secondSection?.querySelector('h2')?.innerText, 'Payment Information');"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"form"}," element within the second ",{"t":"code","v":"section"}," element."]}],"test":"const secondSection = document.querySelectorAll('section')?.[1];\nassert.exists(secondSection?.querySelector('form'));"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"input"}," element with an ",{"t":"code","v":"id"}," and ",{"t":"code","v":"name"}," of ",{"t":"code","v":"card-name"}," within your form."]}],"test":"const secondSection = document.querySelectorAll('section')?.[1];\nassert.exists(secondSection?.querySelector('form input#card-name'));\nassert.exists(secondSection?.querySelector('form input[name=\"card-name\"]'));"},{"text":[{"t":"p","c":["Your card name input should have a ",{"t":"code","v":"type"}," of ",{"t":"code","v":"text"},"."]}],"test":"const cardNameInput = document.getElementById('card-name');\nassert.exists(cardNameInput);\nassert.equal(cardNameInput.getAttribute('type'), 'text');"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"input"}," element with an ",{"t":"code","v":"id"}," and ",{"t":"code","v":"name"}," of ",{"t":"code","v":"card-number"}," within your form."]}],"test":"const secondSection = document.querySelectorAll('section')?.[1];\nassert.exists(secondSection?.querySelector('form input#card-number'));\nassert.exists(secondSection?.querySelector('form input[name=\"card-number\"]'));"},{"text":[{"t":"p","c":["Your card number input should have a ",{"t":"code","v":"type"}," of ",{"t":"code","v":"text"},"."]}],"test":"const cardNumberInput = document.getElementById('card-number');\nassert.exists(cardNumberInput);\nassert.equal(cardNumberInput.getAttribute('type'), 'text');"},{"text":[{"t":"p","c":["All of your ",{"t":"code","v":"input"}," elements that aren't a ",{"t":"code","v":"type"}," of ",{"t":"code","v":"submit"}," should have a ",{"t":"code","v":"label"}," element associated with them."]}],"test":"const inputs = document.querySelectorAll('input:not([type=\"submit\"])');\nassert.isAtLeast(inputs.length, 1);\ninputs.forEach(input => {\n  const label = document.querySelector(`label[for=\"${input.id}\"]`) || input.parentElement;\n  assert.exists(label);\n  assert.equal(label.tagName, \"LABEL\");\n});"},{"text":[{"t":"p","c":["You should have at least two ",{"t":"code","v":"input"}," elements with the ",{"t":"code","v":"required"}," attribute."]}],"test":"const inputs = document.querySelectorAll('input');\nconst requiredInputs = Array.from(inputs).filter(input => input.required);\nassert.isAtLeast(requiredInputs?.length, 2)"},{"text":[{"t":"p","c":["You should include a ",{"t":"code","v":"span"}," element with the text ",{"t":"code","v":"*"}," inside the ",{"t":"code","v":"label"}," element for each required input."]}],"test":"const requiredInputs = Array.from(document.querySelectorAll('input'))\n  .filter(input => input.required);\n\nassert.isNotEmpty(requiredInputs);\n\nrequiredInputs.forEach(input => {\n  const label = document.querySelector(`label[for=\"${input.id}\"]`) || input.parentElement;\n  assert.exists(label);\n  assert.equal(label.tagName, \"LABEL\");\n  const span = label?.querySelector('span');\n  assert.equal(span?.textContent.trim(), '*');\n});"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"span"}," elements should have ",{"t":"code","v":"aria-hidden"}," set to ",{"t":"code","v":"true"},"."]}],"test":"const requiredInputs = Array.from(document.querySelectorAll('input'))\n  .filter(input => input.required);\n\nassert.isNotEmpty(requiredInputs);\n\nrequiredInputs.forEach(input => {\n  const label = document.querySelector(`label[for=\"${input.id}\"]`) || input.parentElement;\n  assert.exists(label);\n  assert.equal(label.tagName, \"LABEL\");\n  const span = label?.querySelector('span');\n  assert.equal(span?.getAttribute('aria-hidden'), 'true');\n});"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"p"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"card-number-help"}," immediately after the card number input."]}],"test":"const cardNumberInput = document.getElementById('card-number');\nconst cardNumberHelp = document.getElementById('card-number-help');\n\nassert.exists(cardNumberHelp);\nconst nextElement = cardNumberInput.parentElement?.tagName === 'LABEL'\n  ? cardNumberInput.parentElement.nextElementSibling\n  : cardNumberInput.nextElementSibling;\nassert.equal(nextElement, cardNumberHelp);"},{"text":[{"t":"p","c":["Your card number help text should not be empty."]}],"test":"const cardNumberHelp = document.getElementById('card-number-help');\nassert.isString(cardNumberHelp?.textContent);\nassert.isAbove(cardNumberHelp?.textContent.trim().length, 0);"},{"text":[{"t":"p","c":["Your card number input should have ",{"t":"code","v":"aria-describedby"}," set to ",{"t":"code","v":"card-number-help"},"."]}],"test":"const cardNumberInput = document.getElementById('card-number');\nassert.equal(cardNumberInput.getAttribute('aria-describedby'), 'card-number-help');"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"UTF-8\" />\n    <title>Checkout Page</title>\n</head>\n\n<body>\n\n</body>\n\n</html>"}]},"solutions":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Checkout Page</title>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>Checkout</h1>\n\n        <section>\n            <h2>Your Cart</h2>\n            <img src=\"https://cdn.freecodecamp.org/curriculum/labs/spoon.jpg\" alt=\"Left-handed spoon\">\n            <p>Left-handed spoon</p>\n            <p>$29.99</p>\n        </section>\n\n        <section>\n            <h2>Payment Information</h2>\n            <form action=\"/submit-payment\" method=\"POST\">\n                <div>\n                    <label for=\"card-name\">Cardholder Name <span aria-hidden=\"true\">*</span></label>\n                    <input type=\"text\" id=\"card-name\" name=\"card-name\" required>\n                </div>\n                <div>\n                    <label for=\"card-number\">Card Number <span aria-hidden=\"true\">*</span></label>\n                    <input type=\"text\" id=\"card-number\" name=\"card-number\" aria-describedby=\"card-number-help\" required>\n                    <p id=\"card-number-help\">Please enter your 16-digit card number without spaces or dashes.</p>\n                </div>\n                <div>\n                    <label for=\"expiry-date\">Expiry Date <span aria-hidden=\"true\">*</span></label>\n                    <input type=\"text\" id=\"expiry-date\" name=\"expiry-date\" placeholder=\"MM/YY\" required>\n                </div>\n                <div>\n                    <label for=\"cvv\">CVV <span aria-hidden=\"true\">*</span></label>\n                    <input type=\"text\" id=\"cvv\" name=\"cvv\" required aria-label=\"Card Verification Value\">\n                </div>\n                <input type=\"submit\" value=\"Place Order\">\n            </form>\n        </section>\n    </div>\n</body>\n</html>"}]}]}