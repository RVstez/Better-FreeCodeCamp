{"name":"lab-confidential-email-page","kind":"lab","layout":"link","multifile":true,"editableBoundaries":false,"helpCategory":"HTML-CSS","challenges":[{"id":"66bba6fff611169359d9d36a","title":"Build a Confidential Email Page","dashedName":"build-a-confidential-email-page","challengeType":25,"demoType":"onClick","description":[{"t":"p","c":[{"t":"strong","c":["Objective:"]}," Fulfill the user stories below and get all the tests to pass to complete the lab."]},{"t":"p","c":[{"t":"strong","c":["User Stories:"]}]},{"t":"ol","items":[[{"t":"p","c":["You should have a ",{"t":"code","v":"main"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"email"},"."]}],[{"t":"p","c":["Your ",{"t":"code","v":"#email"}," element should have ",{"t":"code","v":"padding"}," of ",{"t":"code","v":"50px"},", a top margin of ",{"t":"code","v":"50px"},", a ",{"t":"code","v":"width"}," of ",{"t":"code","v":"500px"},", and a ",{"t":"code","v":"border"}," that's ",{"t":"code","v":"2px"},"."]}],[{"t":"p","c":["The total width of your ",{"t":"code","v":"#email"}," element, including paddings and borders, should be ",{"t":"code","v":"500px"},"."]}],[{"t":"p","c":["You should have two ",{"t":"code","v":"div"}," elements, one with an id of ",{"t":"code","v":"confidential"}," and the other with an id of ",{"t":"code","v":"top-secret"},", within your ",{"t":"code","v":"#email"}," element."]}],[{"t":"p","c":["Your ",{"t":"code","v":"#confidential"}," and ",{"t":"code","v":"#top-secret"}," elements should have a ",{"t":"code","v":"display"}," of ",{"t":"code","v":"inline-block"},"."]}],[{"t":"p","c":["Your ",{"t":"code","v":"#confidential"}," and ",{"t":"code","v":"#top-secret"}," elements should have a ",{"t":"code","v":"padding"},", a left margin, and a ",{"t":"code","v":"border"},"."]}],[{"t":"p","c":["The ",{"t":"code","v":"#confidential"}," element should have the text ",{"t":"code","v":"CONFIDENTIAL"},"."]}],[{"t":"p","c":["The ",{"t":"code","v":"#top-secret"}," element should have the text ",{"t":"code","v":"TOP SECRET"},"."]}],[{"t":"p","c":["Your ",{"t":"code","v":"#confidential"}," and ",{"t":"code","v":"#top-secret"}," elements should be rotated using a CSS transform."]}],[{"t":"p","c":["You should have at least three paragraph elements within your ",{"t":"code","v":"#email"}," element."]}],[{"t":"p","c":["You should have at least three ",{"t":"code","v":"span"}," elements with a class of ",{"t":"code","v":"blurred"},", within your paragraph elements."]}],[{"t":"p","c":["You should have a ",{"t":"code","v":"blurred"}," selector that blurs the element ",{"t":"code","v":"3px"}," using a CSS filter."]}]]}],"hints":[{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"main"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"email"},"."]}],"test":"assert.exists(document.querySelector('main#email'));"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"#email"}," selector that sets its elements' ",{"t":"code","v":"padding"}," on all sides to ",{"t":"code","v":"50px"},"."]}],"test":"assert.equal(new __helpers.CSSHelp(document).getStyle('#email')?.getPropertyValue('padding'), '50px');"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"#email"}," selector that sets its elements' ",{"t":"code","v":"margin-top"}," to ",{"t":"code","v":"50px"},"."]}],"test":"assert.equal(new __helpers.CSSHelp(document).getStyle('#email')?.getPropertyValue('margin-top'), '50px');"},{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"#email"}," selector that sets its elements' ",{"t":"code","v":"width"}," to ",{"t":"code","v":"500px"},"."]}],"test":"assert.equal(new __helpers.CSSHelp(document).getStyle('#email')?.getPropertyValue('width'), '500px');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#email"}," element should have a ",{"t":"code","v":"2px"}," border."]}],"test":"assert.equal(new __helpers.CSSHelp(document).getStyle('#email')?.getPropertyValue('border-width'), '2px');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#email"}," element should have a ",{"t":"code","v":"box-sizing"}," of ",{"t":"code","v":"border-box"},"."]}],"test":"assert.equal(new __helpers.CSSHelp(document).getStyle('#email')?.boxSizing, 'border-box');"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"div"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"confidential"}," within your ",{"t":"code","v":"#email"}," element."]}],"test":"assert.exists(document.querySelector('#email > div#confidential'));"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"div"}," element with an ",{"t":"code","v":"id"}," of ",{"t":"code","v":"top-secret"}," within your ",{"t":"code","v":"#email"}," element."]}],"test":"assert.exists(document.querySelector('#email > div#top-secret'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#confidential"}," element should have its ",{"t":"code","v":"display"}," set to ",{"t":"code","v":"inline-block"},"."]}],"test":"assert.equal(window.getComputedStyle(document.querySelector('#confidential'))?.display, 'inline-block');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#top-secret"}," element should have its ",{"t":"code","v":"display"}," set to ",{"t":"code","v":"inline-block"},"."]}],"test":"assert.equal(window.getComputedStyle(document.querySelector('#top-secret'))?.display, 'inline-block');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#confidential"}," element should have a ",{"t":"code","v":"padding"}," on all sides."]}],"test":"const style = window.getComputedStyle(document.querySelector('#confidential'));\nassert.notEqual(style?.paddingTop, '0px');\nassert.notEqual(style?.paddingRight, '0px');\nassert.notEqual(style?.paddingBottom, '0px');\nassert.notEqual(style?.paddingLeft, '0px');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#top-secret"}," element should have a ",{"t":"code","v":"padding"}," on all sides."]}],"test":"const style = window.getComputedStyle(document.querySelector('#top-secret'));\nassert.notEqual(style?.paddingTop, '0px');\nassert.notEqual(style?.paddingRight, '0px');\nassert.notEqual(style?.paddingBottom, '0px');\nassert.notEqual(style?.paddingLeft, '0px');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#confidential"}," element should have a left margin."]}],"test":"assert.notEqual(window.getComputedStyle(document.querySelector('#confidential'))?.marginLeft, '0px');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#top-secret"}," element should have a left margin."]}],"test":"assert.notEqual(window.getComputedStyle(document.querySelector('#top-secret'))?.marginLeft, '0px');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#confidential"}," element should have a ",{"t":"code","v":"border"},"."]}],"test":"assert.notEqual(window.getComputedStyle(document.querySelector('#confidential'))?.borderWidth, '0px');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#top-secret"}," element should have a ",{"t":"code","v":"border"},"."]}],"test":"assert.notEqual(window.getComputedStyle(document.querySelector('#top-secret'))?.borderWidth, '0px');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#confidential"}," element's text should be ",{"t":"code","v":"CONFIDENTIAL"},". You have either omitted the text, or have a typo."]}],"test":"assert.equal(document.querySelector('#confidential').innerText.toLowerCase(), 'confidential' );"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#top-secret"}," element's text should be ",{"t":"code","v":"TOP SECRET"},". You have either omitted the text, or have a typo."]}],"test":"assert.equal(document.querySelector('#top-secret').innerText.toLowerCase(), 'top secret' );"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#confidential"}," element should use a CSS ",{"t":"code","v":"transform"}," to rotate the element."]}],"test":"assert.notEqual(window.getComputedStyle(document.querySelector('#confidential'))?.transform, 'none');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"#top-secret"}," element should use a CSS ",{"t":"code","v":"transform"}," to rotate the element."]}],"test":"assert.notEqual(window.getComputedStyle(document.querySelector('#top-secret'))?.transform, 'none');"},{"text":[{"t":"p","c":["You should have at least three paragraph elements within your ",{"t":"code","v":"#email"}," element."]}],"test":"assert.isAtLeast(document.querySelectorAll('#email > p').length, 3);"},{"text":[{"t":"p","c":["You should have at least three ",{"t":"code","v":"span"}," elements with a class of ",{"t":"code","v":"blurred"}," within your paragraphs."]}],"test":"assert.isAtLeast(document.querySelectorAll('p > span.blurred').length, 3);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".blurred"}," elements should not be empty."]}],"test":"const els = document.querySelectorAll('.blurred');\nassert.isAtLeast(els.length, 1);\nels.forEach(el => assert.isAtLeast(el.innerText.length , 1))"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":".blurred"}," selector that set its elements ",{"t":"code","v":"filter"}," to ",{"t":"code","v":"blur(3px)"},"."]}],"test":"assert.equal(new __helpers.CSSHelp(document).getStyle('.blurred')?.filter, 'blur(3px)');"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Confidential Email</title>\n\n</head>\n\n<body>\n\n</body>\n\n</html>"},{"lang":"css","contents":""}]},"solutions":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Secret Marshmallow Mission</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n\n<body>\n  <main id=\"email\">\n    <div id=\"confidential\">CONFIDENTIAL</div>\n    <p>Dear Agent <span class=\"blurred\">S'more,</span></p>\n    <p>We have an emergency. The secret formula for our <span class=\"blurred\">Mega Marshmallow</span> has been\n      compromised. This formula is what makes our marshmallows the fluffiest and most delicious.</p>\n    <p>We suspect that <span class=\"blurred\">Professor Puff</span> is behind this. He has taken the formula to his\n      hidden laboratory. Your mission is to infiltrate the lab and secure the formula before it's too late.</p>\n    <p>Be sure to keep the lab's location confidential. Any leak of this information could jeopardize the entire\n      operation.</p>\n    <div id=\"top-secret\">TOP SECRET</div>\n  </main>\n</body>\n\n</html>"},{"lang":"css","contents":"#email {\n  background-color: SeaShell;\n  margin: 50px auto;\n  padding: 50px;\n  width: 500px;\n  border: 2px solid black;\n  box-shadow: 5px 3px 3px gray;\n  box-sizing: border-box;\n}\n\n#confidential {\n  display: inline-block;\n  margin-left: 100px;\n  padding: 10px;\n  text-align: center;\n  font-size: 30px;\n  transform: rotate(-20deg);\n  color: red;\n  border: 5px solid red;\n  font-weight: bold;\n}\n\n#top-secret {\n  margin-left: 200px;\n  display: inline-block;\n  padding: 10px;\n  text-align: center;\n  font-size: 20px;\n  transform: rotate(15deg);\n  color: red;\n  border: 5px solid red;\n  font-weight: bold;\n}\n\n.blurred {\n  filter: blur(3px);\n}"}]}]}