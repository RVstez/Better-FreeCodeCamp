{"name":"lab-pricing-plans-layout","kind":"lab","layout":"link","multifile":true,"editableBoundaries":false,"helpCategory":"HTML-CSS","challenges":[{"id":"68e45a2b4ab9b2f48b1cc6df","title":"Design a Pricing Plans Layout Page","dashedName":"design-a-pricing-plans-layout-page","challengeType":25,"demoType":"onClick","description":[{"t":"p","c":[{"t":"strong","c":["Objective:"]}," Fulfill the user stories below and get all the tests to pass to complete the lab."]},{"t":"p","c":[{"t":"strong","c":["User Stories:"]}]},{"t":"ol","items":[[{"t":"p","c":["Your page should have an ",{"t":"code","v":"h1"}," element with the text ",{"t":"code","v":"Pricing Plans"},"."]}],[{"t":"p","c":["Your page should have a ",{"t":"code","v":"div"}," element with the class ",{"t":"code","v":"pricing-container"}," below the ",{"t":"code","v":"h1"}," element."]},{"t":"ul","items":[[{"t":"p","c":["The ",{"t":"code","v":".pricing-container"}," selector should have a ",{"t":"code","v":"display"}," property with the value of ",{"t":"code","v":"flex"}," and a ",{"t":"code","v":"flex-wrap"}," property with the value of ",{"t":"code","v":"wrap"},"."]}]]}],[{"t":"p","c":["Within the ",{"t":"code","v":".pricing-container"}," element, you should have three ",{"t":"code","v":"div"}," elements with the class ",{"t":"code","v":"pricing-card"}," to represent the pricing plans."]},{"t":"ul","items":[[{"t":"p","c":["One of the ",{"t":"code","v":".pricing-card"}," elements should have the class ",{"t":"code","v":"basic-plan"}," in addition to the ",{"t":"code","v":"pricing-card"}," class."]}],[{"t":"p","c":["One of the ",{"t":"code","v":".pricing-card"}," elements should have the class ",{"t":"code","v":"pro-plan"}," in addition to the ",{"t":"code","v":"pricing-card"}," class."]}],[{"t":"p","c":["One of the ",{"t":"code","v":".pricing-card"}," elements should have the class ",{"t":"code","v":"premium-plan"}," in addition to the ",{"t":"code","v":"pricing-card"}," class."]}]]}],[{"t":"p","c":["Your ",{"t":"code","v":".basic-plan"}," element should have an ",{"t":"code","v":"h2"}," element with the text ",{"t":"code","v":"Basic"},"."]}],[{"t":"p","c":["Your ",{"t":"code","v":".basic-plan"}," element should have a ",{"t":"code","v":"p"}," element with the text ",{"t":"code","v":"$9/month"},"."]}],[{"t":"p","c":["Your ",{"t":"code","v":".pro-plan"}," element should have an ",{"t":"code","v":"h2"}," element with the text ",{"t":"code","v":"Pro"},"."]}],[{"t":"p","c":["Your ",{"t":"code","v":".pro-plan"}," element should have a ",{"t":"code","v":"p"}," element with the text ",{"t":"code","v":"$19/month"},"."]}],[{"t":"p","c":["Your ",{"t":"code","v":".premium-plan"}," element should have an ",{"t":"code","v":"h2"}," element with the text ",{"t":"code","v":"Premium"},"."]}],[{"t":"p","c":["Your ",{"t":"code","v":".premium-plan"}," element should have a ",{"t":"code","v":"p"}," element with the text ",{"t":"code","v":"$29/month"},"."]}],[{"t":"p","c":["Each of your ",{"t":"code","v":".pricing-card"}," elements should:"]},{"t":"ul","items":[[{"t":"p","c":["Use Flexbox to stack its content in a column and justify the space between the children using ",{"t":"code","v":"space-between"},"."]}],[{"t":"p","c":["Set the ",{"t":"code","v":"flex"}," property to ",{"t":"code","v":"0 0 200px"}," to give it a consistent width and prevent it from growing or shrinking in the layout."]}],[{"t":"p","c":["Set the ",{"t":"code","v":"border"}," property to ",{"t":"code","v":"2px solid black"}," to see how the different cards take up space."]}]]}],[{"t":"p","c":["The ",{"t":"code","v":".basic-plan"}," element should appear first in the layout. You should use the ",{"t":"code","v":"order"}," property for this."]}],[{"t":"p","c":["The ",{"t":"code","v":".pro-plan"}," element should appear second in the layout. You should use the ",{"t":"code","v":"order"}," property and set its ",{"t":"code","v":"flex-grow"}," property to ",{"t":"code","v":"2"}," so it takes up more space than the other plans."]}],[