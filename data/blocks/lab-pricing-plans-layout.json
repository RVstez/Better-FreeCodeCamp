the ",{"t":"code","v":".pricing-container"}," element."]}],"test":"const divEls = document.querySelectorAll('.pricing-container .pricing-card');\nassert.lengthOf(divEls, 3);"},{"text":[{"t":"p","c":["One of your ",{"t":"code","v":".pricing-card"}," elements should have the class ",{"t":"code","v":"basic-plan"},"."]}],"test":"assert.exists(document.querySelector('div.pricing-card.basic-plan'));"},{"text":[{"t":"p","c":["One of your ",{"t":"code","v":".pricing-card"}," elements should have the class ",{"t":"code","v":"premium-plan"},"."]}],"test":"assert.exists(document.querySelector('div.pricing-card.premium-plan'));"},{"text":[{"t":"p","c":["One of your ",{"t":"code","v":".pricing-card"}," elements should have the class ",{"t":"code","v":"pro-plan"},"."]}],"test":"assert.exists(document.querySelector('div.pricing-card.pro-plan'));"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":".pricing-card"}," selector."]}],"test":"assert.exists(new __helpers.CSSHelp(document).getStyle('.pricing-card'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".pricing-card"}," selector should have the property ",{"t":"code","v":"display"}," with a value of ",{"t":"code","v":"flex"},"."]}],"test":"assert.strictEqual(new __helpers.CSSHelp(document).getStyle('.pricing-card')?.display, 'flex');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".pricing-card"}," selector should have the property ",{"t":"code","v":"flex-direction"}," with a value of ",{"t":"code","v":"column"},"."]}],"test":"assert.strictEqual(new __helpers.CSSHelp(document).getStyle('.pricing-card')?.flexDirection, 'column');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".pricing-card"}," selector should have the property ",{"t":"code","v":"justify-content"}," with a value of ",{"t":"code","v":"space-between"},"."]}],"test":"assert.strictEqual(new __helpers.CSSHelp(document).getStyle('.pricing-card')?.justifyContent, 'space-between');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".pricing-card"}," selector should have the property ",{"t":"code","v":"flex"}," with a value of ",{"t":"code","v":"0 0 200px"},"."]}],"test":"assert.strictEqual(new __helpers.CSSHelp(document).getStyle('.pricing-card')?.flex, '0 0 200px');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".pricing-card"}," selector should have the property ",{"t":"code","v":"border"}," with a value of ",{"t":"code","v":"2px solid black"},"."]}],"test":"assert.strictEqual(new __helpers.CSSHelp(document).getStyle('.pricing-card')?.border, '2px solid black');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".basic-plan"}," selector should have the property ",{"t":"code","v":"order"}," with a value of ",{"t":"code","v":"0"},"."]}],"test":"assert.strictEqual(new __helpers.CSSHelp(document).getStyle('.basic-plan')?.order, '0');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".basic-plan"}," element should have an ",{"t":"code","v":"h2"}," element with the text ",{"t":"code","v":"Basic"},"."]}],"test":"const h2 = document.querySelector('.basic-plan > h2');\nassert.strictEqual(h2?.textContent.trim(), 'Basic');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".basic-plan"}," element should have a ",{"t":"code","v":"p"}," element with the text ",{"t":"code","v":"$9/month"},"."]}],"test":"const p = document.querySelector('.basic-plan > p');\nassert.strictEqual(p?.textContent.trim(), '$9/month');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".pro-plan"}," element should have an ",{"t":"code","v":"h2"}," element with the text ",{"t":"code","v":"Pro"},"."]}],"test":"const h2 = document.querySelector('.pro-plan > h2');\nassert.strictEqual(h2?.textContent.trim(), 'Pro');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".pro-plan"}," element should have a ",{"t":"code","v":"p"}," element with the text ",{"t":"code","v":"$19/month"},"."]}],"test":"const p = document.querySelector('.pro-plan > p');\nassert.strictEqual(p?.textContent.trim(), '$19/month');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".pro-plan"}," element should have the property ",{"t":"code","v":"order"}," with a value of ",{"t":"code","v":"1"},"."]}],"test":"assert.strictEqual(new __helpers.CSSHelp(document).getStyle('.pro-plan')?.order, '1');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".pro-plan"}," element should have the property ",{"t":"code","v":"flex-grow"}," with a value of ",{"t":"code","v":"2"},"."]}],"test":"assert.strictEqual(new __helpers.CSSHelp(document).getStyle('.pro-plan')?.flexGrow, '2');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".premium-plan"}," element should have an ",{"t":"code","v":"h2"}," element with the text ",{"t":"code","v":"Premium"},"."]}],"test":"const h2 = document.querySelector('.premium-plan > h2');\nassert.strictEqual(h2?.textContent.trim(), 'Premium');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".premium-plan"}," element should have a ",{"t":"code","v":"p"}," element with the text ",{"t":"code","v":"$29/month"},"."]}],"test":"const p = document.querySelector('.premium-plan > p');\nassert.strictEqual(p?.textContent.trim(), '$29/month');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"premium-plan"}," element should be the last element in the layout and have the property ",{"t":"code","v":"order"}," and the value ",{"t":"code","v":"2"},"."]}],"test":"assert.strictEqual(new __helpers.CSSHelp(document).getStyle('.premium-plan')?.order, '2');"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Pricing Plans Layout Page</title>\n  </head>\n  <body></body>\n</html>"},{"lang":"css","contents":""}]},"solutions":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Pricing Plans Layout</title>\n    <link rel=\"stylesheet\" href=\"styles.css\" />\n  </head>\n  <body>\n    <h1>Pricing Plans</h1>\n    <div class=\"pricing-container\">\n      <div class=\"pricing-card pro-plan\">\n        <h2>Pro</h2>\n        <p class=\"price\">$19/month</p>\n        <ul class=\"features\">\n          <li><span class=\"check\">✓</span> Access to our core features</li>\n          <li><span class=\"check\">✓</span> Email support</li>\n          <li><span class=\"check\">✓</span> Advanced analytics</li>\n          <li><span class=\"check\">✓</span> Custom integrations</li>\n          <li><span class=\"cross\">✗</span> Priority support</li>\n        </ul>\n        <a href=\"#\">Choose Plan</a>\n      </div>\n\n      <div class=\"pricing-card basic-plan\">\n        <h2>Basic</h2>\n        <p class=\"price\">$9/month</p>\n        <ul class=\"features\">\n          <li><span class=\"check\">✓</span> Access to our core features</li>\n          <li><span class=\"check\">✓</span> Email support</li>\n          <li><span class=\"cross\">✗</span> Advanced analytics</li>\n          <li><span class=\"cross\">✗</span> Custom integrations</li>\n          <li><span class=\"cross\">✗</span> Priority support</li>\n        </ul>\n        <a href=\"#\">Choose Plan</a>\n      </div>\n\n      <div class=\"pricing-card premium-plan\">\n        <h2>Premium</h2>\n        <p class=\"price\">$29/month</p>\n        <ul class=\"features\">\n          <li><span class=\"check\">✓</span> Access to our core features</li>\n          <li><span class=\"check\">✓</span> Email support</li>\n          <li><span class=\"check\">✓</span> Advanced analytics</li>\n          <li><span class=\"check\">✓</span> Custom integrations</li>\n          <li><span class=\"check\">✓</span> Priority support</li>\n        </ul>\n        <a href=\"#\">Choose Plan</a>\n      </div>\n    </div>\n  </body>\n</html>"},{"lang":"css","contents":"body {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-direction: column;\n  min-height: 100vh;\n}\n\nh1 {\n  margin-bottom: 20px;\n}\n\nh2,\np {\n  margin: 0;\n}\n\n.pricing-container {\n  display: flex;\n  flex-wrap: wrap;\n  align-content: center;\n  border: 2px solid #000;\n  gap: 20px;\n  width: 80%;\n  max-width: 900px;\n  height: 70vh;\n  padding: 0 20px;\n}\n\n.pricing-card {\n  background: rgb(247, 247, 247);\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n  padding: 20px;\n  flex: 0 0 200px;\n  text-align: center;\n  transition: transform 0.3s ease;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  border: 2px solid black;\n}\n\n.pricing-card:hover {\n  transform: scale(1.05);\n}\n\n.price {\n  font-size: 1.5rem;\n  font-weight: bold;\n  color: #3e3e3e;\n  margin: 10px;\n  border-bottom: 1px solid #433d28;\n}\n\n.features {\n  list-style-type: none;\n  padding: 0;\n  text-align: left;\n}\n\n.features li {\n  padding: 5px 0;\n  font-size: 0.95rem;\n}\n\n.check {\n  color: #219c54;\n  font-weight: bold;\n  margin-right: 8px;\n}\n\n.cross {\n  color: crimson;\n  font-weight: bold;\n  margin-right: 8px;\n}\n\na {\n  text-decoration: none;\n  display: inline-block;\n  margin-top: 15px;\n  background: #f1be32;\n  color: #000;\n  font-weight: bold;\n  border: 3px solid #eebe3a;\n  padding: 5px;\n  transition: background 0.3s;\n}\n\na:hover {\n  background: #f7c436;\n}\n\n.basic-plan {\n  order: 0;\n}\n.pro-plan {\n  order: 1;\n  flex-grow: 2;\n  background: #f0f8ff;\n}\n.premium-plan {\n  order: 2;\n}\n\n@media screen and (max-width: 1000px) {\n  .pricing-container {\n    height: auto;\n    padding-bottom: 20px;\n  }\n\n  h1 {\n    display: block;\n    font-size: 1.5rem;\n    text-align: center;\n  }\n\n  .pricing-card {\n    flex: 0 0 175px;\n  }\n}\n\n@media screen and (max-width: 650px) {\n  .pricing-container {\n    flex-direction: column;\n    height: auto;\n  }\n\n  .pricing-card {\n    flex: 1 1 auto;\n    width: 100%;\n  }\n}"}]}]}