{"name":"workshop-accessible-audio-controller","kind":"workshop","layout":"challenge-grid","multifile":true,"editableBoundaries":true,"helpCategory":"HTML-CSS","challenges":[{"id":"68e6aff5325410118e76e7be","title":"Step 1","dashedName":"step-1","challengeType":0,"demoType":"onLoad","description":[{"t":"p","c":["In this workshop, you will practice working with ARIA by building an accessible audio controller."]},{"t":"p","c":["To start, add an ",{"t":"code","v":"h1"}," element with the text ",{"t":"code","v":"Audio Controls"},"."]}],"hints":[{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"h1"}," element."]}],"test":"assert.exists(document.querySelector('h1'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"h1"}," element should be inside your ",{"t":"code","v":"body"}," element."]}],"test":"assert.exists(document.querySelector('body > h1'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"h1"}," element should have the text ",{"t":"code","v":"Audio Controls"},"."]}],"test":"const h1Text = document.querySelector('h1')?.innerText.trim();\nassert.strictEqual(h1Text, 'Audio Controls');"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>Accessible Controls</title>\n  </head>\n  <body>\n\n    \n\n  </body>\n</html>","editable":[8,9]}]},"solutions":[],"step":1},{"id":"68eac57fadcc662ce917e75e","title":"Step 2","dashedName":"step-2","challengeType":0,"description":[{"t":"p","c":["Next, add a ",{"t":"code","v":"button"}," element with the ",{"t":"code","v":"type"}," attribute set to the value ",{"t":"code","v":"button"},"."]},{"t":"p","c":["The ",{"t":"code","v":"button"}," element's text should be ",{"t":"code","v":"Play"},"."]}],"hints":[{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"button"}," element."]}],"test":"assert.exists(document.querySelector('button'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"button"}," element should have a ",{"t":"code","v":"type"}," attribute."]}],"test":"const button = document.querySelector('button');\nassert.isTrue(button?.hasAttribute('type'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"button"}," element should have the ",{"t":"code","v":"type"}," attribute set to ",{"t":"code","v":"button"},"."]}],"test":"const button = document.querySelector('button');\nassert.strictEqual(button?.getAttribute('type'), 'button');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"button"}," element should have the text ",{"t":"code","v":"Play"},"."]}],"test":"const button = document.querySelector('button');\nassert.strictEqual(button?.innerText.trim(), 'Play');"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>Accessible Controls</title>\n  </head>\n  <body>\n\n    <h1>Audio Controls</h1>\n\n    \n\n  </body>\n</html>","editable":[10,11]}]},"solutions":[],"step":2},{"id":"68eb7f2397da251a40e04aa2","title":"Step 3","dashedName":"step-3","challengeType":0,"description":[{"t":"p","c":["Next, add a ",{"t":"code","v":"div"}," element to contain all the elements for the volume control."]},{"t":"p","c":["A ",{"t":"code","v":"span"}," element is a generic inline container for content. It's commonly used to style a piece of text differently from the surrounding text, or to wrap text and give it an ",{"t":"code","v":"id"}," that other elements (such as ARIA attributes) can reference."]},{"t":"p","c":["Inside the ",{"t":"code","v":"div"}," element, nest a ",{"t":"code","v":"span"}," element with an ",{"t":"code","v":"id"}," attribute set to ",{"t":"code","v":"volume-label"},". Also, the text for the ",{"t":"code","v":"span"}," element should be ",{"t":"code","v":"Volume"},"."]},{"t":"p","c":["The ",{"t":"code","v":"id"}," will later be referenced by ARIA attributes so assistive technologies can identify this text as the label for the volume control."]}],"hints":[{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"div"}," element below your ",{"t":"code","v":"button"}," element."]}],"test":"assert.exists(document.querySelector('button + div'));"},{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"span"}," element inside your ",{"t":"code","v":"div"}," element."]}],"test":"assert.exists(document.querySelector('button + div > span'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"span"}," element should have an ",{"t":"code","v":"id"}," attribute."]}],"test":"const spanEl = document.querySelector('button + div > span');\nassert.isTrue(spanEl?.hasAttribute('id'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"span"}," element should have an ",{"t":"code","v":"id"}," attribute with the value set to ",{"t":"code","v":"volume-label"},"."]}],"test":"const spanEl = document.querySelector('button + div > span');\nassert.equal(spanEl?.getAttribute('id'), 'volume-label');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"span"}," element should have the text ",{"t":"code","v":"Volume"},"."]}],"test":"const spanEl = document.querySelector('button + div > span');\nassert.equal(spanEl?.innerText.trim(), 'Volume');"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>Accessible Controls</title>\n  </head>\n  <body>\n\n    <h1>Audio Controls</h1>\n\n    <button type=\"button\">Play</button>\n\n\n\n  </body>\n</html>","editable":[12,13]}]},"solutions":[],"step":3},{"id":"68ec0a48c9d6db3594d768c3","title":"Step 4","dashedName":"step-4","challengeType":0,"description":[{"t":"p","c":["Now it is time to add another ",{"t":"code","v":"span"}," element."]},{"t":"p","c":["This ",{"t":"code","v":"span"}," element should have an ",{"t":"code","v":"id"}," attribute set to ",{"t":"code","v":"volume-description"},". Also, the text for this ",{"t":"code","v":"span"}," element should be ",{"t":"code","v":"Adjust the sound level"},"."]},{"t":"p","c":["Similar to the previous ",{"t":"code","v":"span"}," element, the ",{"t":"code","v":"id"}," of this ",{"t":"code","v":"span"}," will later be referenced by ARIA attributes so assistive technologies can identify this text as the description for the volume control."]}],"hints":[{"text":[{"t":"p","c":["You should have two ",{"t":"code","v":"span"}," elements inside the ",{"t":"code","v":"div"}," element."]}],"test":"const spans = document.querySelectorAll('div > span');\nassert.lengthOf(spans, 2);"},{"text":[{"t":"p","c":["Your second ",{"t":"code","v":"span"}," element should have an ",{"t":"code","v":"id"}," attribute."]}],"test":"const secondSpanEl = document.querySelector('div > span:nth-of-type(2)');\nassert.isTrue(secondSpanEl?.hasAttribute('id'));"},{"text":[{"t":"p","c":["Your second ",{"t":"code","v":"span"}," element should have an ",{"t":"code","v":"id"}," attribute with the value of ",{"t":"code","v":"volume-description"},"."]}],"test":"const secondSpanEl = document.querySelector('div > span:nth-of-type(2)');\nassert.equal(secondSpanEl?.getAttribute('id'), 'volume-description');"},{"text":[{"t":"p","c":["Your second ",{"t":"code","v":"span"}," element should have the text ",{"t":"code","v":"Adjust the sound level"},"."]}],"test":"const secondSpanEl = document.querySelector('div > span:nth-of-type(2)');\nassert.equal(secondSpanEl?.innerText.trim(), 'Adjust the sound level');"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>Accessible Controls</title>\n  </head>\n  <body>\n\n    <h1>Audio Controls</h1>\n\n    <button type=\"button\">Play</button>\n\n    <div>\n      <span id=\"volume-label\">Volume</span>\n    \n    </div>\n\n  </body>\n</html>","editable":[14,15]}]},"solutions":[],"step":4},{"id":"68ed3a96e0ebcc36565b39e5","title":"Step 5","dashedName":"step-5","challengeType":0,"description":[{"t":"p","c":["Next, you need to add an ",{"t":"code","v":"input"}," element with the ",{"t":"code","v":"type"}," attribute set to ",{"t":"code","v":"range"}," to create the volume slider. Set the ",{"t":"code","v":"min"}," attribute to ",{"t":"code","v":"0"},", the ",{"t":"code","v":"max"}," attribute to ",{"t":"code","v":"100"},", and the ",{"t":"code","v":"value"}," attribute to ",{"t":"code","v":"50"}," to define the default volume level."]}],"hints":[{"text":[{"t":"p","c":["You should have an ",{"t":"code","v":"input"}," element below your second ",{"t":"code","v":"span"}," element."]}],"test":"const inputEl = document.querySelector('div > span:nth-of-type(2) + input');\nassert.exists(inputEl);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"type"}," attribute."]}],"test":"const inputEl = document.querySelector('div > span:nth-of-type(2) + input');\nassert.isTrue(inputEl?.hasAttribute('type'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"type"}," attribute with the value ",{"t":"code","v":"range"},"."]}],"test":"const inputEl = document.querySelector('div > span:nth-of-type(2) + input');\nassert.equal(inputEl?.getAttribute('type'), 'range');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"min"}," attribute."]}],"test":"const inputEl = document.querySelector('div > span:nth-of-type(2) + input');\nassert.exists(inputEl?.getAttribute('min'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"min"}," attribute with the value ",{"t":"code","v":"0"},"."]}],"test":"const inputEl = document.querySelector('div > span:nth-of-type(2) + input');\nassert.equal(inputEl?.getAttribute('min'), '0');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"max"}," attribute."]}],"test":"const inputEl = document.querySelector('div > span:nth-of-type(2) + input');\nassert.isTrue(inputEl?.hasAttribute('max'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"max"}," attribute with the value ",{"t":"code","v":"100"},"."]}],"test":"const inputEl = document.querySelector('div > span:nth-of-type(2) + input');\nassert.equal(inputEl?.getAttribute('max'), '100');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"value"}," attribute."]}],"test":"const inputEl = document.querySelector('div > span:nth-of-type(2) + input');\nassert.isTrue(inputEl?.hasAttribute('value'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"value"}," attribute with the value ",{"t":"code","v":"50"},"."]}],"test":"const inputEl = document.querySelector('div > span:nth-of-type(2) + input');\nassert.equal(inputEl?.getAttribute('value'), '50');"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>Accessible Controls</title>\n  </head>\n  <body>\n\n    <h1>Audio Controls</h1>\n\n    <button type=\"button\">Play</button>\n\n    <div>\n      <span id=\"volume-label\">Volume</span>\n      <span id=\"volume-description\">Adjust the sound level</span>\n      \n    </div>\n\n  </body>\n</html>","editable":[15,16]}]},"solutions":[],"step":5},{"id":"68ed4204ab7edc66b6cb2383","title":"Step 6","dashedName":"step-6","challengeType":0,"description":[{"t":"p","c":["As you recall from prior lessons, the ",{"t":"code","v":"aria-labelledby"}," attribute is used when there is existing text on the page that can be used as a label. In this case, you have added the ",{"t":"code","v":"id"}," attribute to your ",{"t":"code","v":"span"}," elements which will now be used here."]},{"t":"p","c":["Add an ",{"t":"code","v":"aria-labelledby"}," attribute to the ",{"t":"code","v":"input"}," element set to ",{"t":"code","v":"volume-label volume-description"},"."]}],"hints":[{"text":[{"t":"p","c":["Your ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"aria-labelledby"}," attribute."]}],"test":"const inputEl = document.querySelector('div > span:nth-of-type(2) + input');\nassert.isTrue(inputEl?.hasAttribute('aria-labelledby'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"input"}," element should have a ",{"t":"code","v":"aria-labelledby"}," attribute with the value ",{"t":"code","v":"volume-label volume-description"},"."]}],"test":"const inputEl = document.querySelector('div > span:nth-of-type(2) + input');\nconst ariaLabelledbyAttr = inputEl?.getAttribute('aria-labelledby');\nassert.oneOf(ariaLabelledbyAttr, ['volume-label volume-description', 'volume-description volume-label']);"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>Accessible Controls</title>\n  </head>\n  <body>\n\n    <h1>Audio Controls</h1>\n\n    <button type=\"button\">Play</button>\n\n    <div>\n      <span id=\"volume-label\">Volume</span>\n      <span id=\"volume-description\">Adjust the sound level</span>\n      <input type=\"range\" min=\"0\" max=\"100\" value=\"50\">\n    </div>\n\n  </body>\n</html>","editable":[15,16]}]},"solutions":[],"step":6},{"id":"68ed488821845990c911a223","title":"Step 7","dashedName":"step-7","challengeType":0,"description":[{"t":"p","c":["Your accessible audio controller is almost complete but there is one last thing to add."]},{"t":"p","c":["Add a ",{"t":"code","v":"button"}," element with the ",{"t":"code","v":"type"}," attribute set to ",{"t":"code","v":"button"}," and with text ",{"t":"code","v":"Mute"}," below the ",{"t":"code","v":"div"}," element."]},{"t":"p","c":["And with that change, you have completed this workshop!"]}],"hints":[{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"button"}," element below the ",{"t":"code","v":"div"}," element."]}],"test":"const buttonEl = document.querySelector('div + button');\nassert.exists(buttonEl);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"button"}," element should have a ",{"t":"code","v":"type"}," attribute."]}],"test":"const buttonEl = document.querySelector('div + button');\nassert.isTrue(buttonEl?.hasAttribute('type'));"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"button"}," element should have a ",{"t":"code","v":"type"}," attribute with the value ",{"t":"code","v":"button"},"."]}],"test":"const buttonEl = document.querySelector('div + button');\nassert.equal(buttonEl?.getAttribute('type'), 'button');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"button"}," element should have the text ",{"t":"code","v":"Mute"},"."]}],"test":"const buttonEl = document.querySelector('div + button');\nassert.equal(buttonEl?.innerText.trim(), 'Mute');"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>Accessible Controls</title>\n  </head>\n  <body>\n\n    <h1>Audio Controls</h1>\n\n    <button type=\"button\">Play</button>\n\n    <div>\n      <span id=\"volume-label\">Volume</span>\n      <span id=\"volume-description\">Adjust the sound level</span>\n      <input type=\"range\" min=\"0\" max=\"100\" value=\"50\"\n        aria-labelledby=\"volume-label volume-description\">\n    </div>\n\n    \n\n  </body>\n</html>","editable":[19,20]}]},"solutions":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>Accessible Controls</title>\n  </head>\n  <body>\n\n    <h1>Audio Controls</h1>\n\n    <button type=\"button\">Play</button>\n\n    <div>\n      <span id=\"volume-label\">Volume</span>\n      <span id=\"volume-description\">Adjust the sound level</span>\n      <input type=\"range\" min=\"0\" max=\"100\" value=\"50\"\n        aria-labelledby=\"volume-label volume-description\">\n    </div>\n\n    <button type=\"button\">Mute</button>\n\n  </body>\n</html>"}],"step":7}]}