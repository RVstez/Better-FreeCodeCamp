{"name":"quiz-css-attribute-selectors","kind":"quiz","layout":"link","multifile":false,"editableBoundaries":false,"helpCategory":"HTML-CSS","challenges":[{"id":"66ed8fd0f45ce3ece4053eaf","title":"CSS Attribute Selectors Quiz","dashedName":"quiz-css-attribute-selectors","challengeType":8,"description":[{"t":"p","c":["To pass the quiz, you must correctly answer at least 9 of the 10 questions below."]}],"pass":{"required":9,"of":10},"sets":[{"questions":[{"text":[{"t":"p","c":["What are CSS attribute selectors used for?"]}],"distractors":[[{"t":"p","c":["To apply styles to elements based on their tag name."]}],[{"t":"p","c":["To apply styles to elements based on their class name."]}],[{"t":"p","c":["To apply styles to elements based on their parent element."]}]],"answer":[{"t":"p","c":["To apply styles to elements based on their attributes."]}]},{"text":[{"t":"p","c":["Which of the following will NOT be selected by this CSS selector?"]},{"t":"code","lang":"css","text":"[title~=\"flower\"] {\n  border: 5px solid yellow;\n}"}],"distractors":[[{"t":"code","lang":"html","text":"<img src=\"img1.jpg\" title=\"clematis flower\" width=\"150\" height=\"113\">"}],[{"t":"code","lang":"html","text":"<img src=\"img2.jpg\" title=\"flower\" width=\"150\" height=\"113\">"}],[{"t":"code","lang":"html","text":"<img src=\"img2.jpg\" title=\"FLOWERS of flower\" width=\"150\" height=\"113\">"}]],"answer":[{"t":"code","lang":"html","text":"<img src=\"img2.jpg\" title=\"flowers\" width=\"150\" height=\"113\">"}]},{"text":[{"t":"p","c":["Which CSS selector matches all ",{"t":"code","v":"p"}," elements with a ",{"t":"code","v":"lang"}," attribute set to ",{"t":"code","v":"\"fr\""},"?"]}],"distractors":[[{"t":"code","lang":"css","text":"p[lang-=\"fr\"] { color: blue; }"}],[{"t":"code","lang":"css","text":"p[lang~=\"fr\"] { color: blue; }"}],[{"t":"code","lang":"css","text":"p[lang==\"fr\"] { color: blue; }"}]],"answer":[{"t":"code","lang":"css","text":"p[lang=\"fr\"] { color: blue; }"}]},{"text":[{"t":"p","c":["Which CSS selector matches all ",{"t":"code","v":"a"}," elements with an ",{"t":"code","v":"href"}," attribute?"]}],"distractors":[[{"t":"code","lang":"css","text":"a(href) { color: green; }"}],[{"t":"code","lang":"css","text":"a { color: green; }"}],[{"t":"code","lang":"css","text":"a[href~=\"\"] { color: green; }"}]],"answer":[{"t":"code","lang":"css","text":"a[href] { color: blue; }"}]},{"text":[{"t":"p","c":["Which CSS selector matches all ordered lists with uppercase Roman numerals?"]}],"distractors":[[{"t":"code","lang":"css","text":"ol[type=\"a\"] { border-color: black; }"}],[{"t":"code","lang":"css","text":"ol[type=\"A\"] { border-color: black; }"}],[{"t":"code","lang":"css","text":"ol[type=\"i\"] { border-color: black; }"}]],"answer":[{"t":"code","lang":"css","text":"ol[type=\"I\"] { border-color: black; }"}]},{"text":[{"t":"p","c":["What is the ",{"t":"code","v":"data-lang"}," attribute commonly used for?"]}],"distractors":[[{"t":"p","c":["To specify the language of the document."]}],[{"t":"p","c":["To define the character encoding of the document."]}],[{"t":"p","c":["To set the language of an element based on its parent element."]}]],"answer":[{"t":"p","c":["To store custom data on an HTML element that CSS or JavaScript can then use."]}]},{"text":[{"t":"p","c":["Which CSS selector should you use to style ",{"t":"code","v":"img"}," elements only if their ",{"t":"code","v":"alt"}," attribute is equal to ",{"t":"code","v":"\"code\""},"?"]}],"distractors":[[{"t":"code","lang":"css","text":"img[alt~=\"code\"] { border: 1px solid red; }"}],[{"t":"code","lang":"css","text":"img[alt==\"code\"] { border: 1px solid red; }"}],[{"t":"code","lang":"css","text":"img[alt*=\"code\"] { border: 1px solid red; }"}]],"answer":[{"t":"code","lang":"css","text":"img[alt=\"code\"] { border: 1px solid red; }"}]},{"text":[{"t":"p","c":["Which CSS selector matches ordered lists with a numerical numbering type?"]}],"distractors":[[{"t":"code","lang":"css","text":"ol[type=\"i\"] { color: purple; }"}],[{"t":"code","lang":"css","text":"ol[type=\"I\"] { color: purple; }"}],[{"t":"code","lang":"css","text":"ol[type=\"a\"] { color: purple; }"}]],"answer":[{"t":"code","lang":"css","text":"ol[type=\"1\"] { color: purple; }"}]},{"text":[{"t":"p","c":["Which of the following CSS selectors would you use to style ",{"t":"code","v":"a"}," elements with both ",{"t":"code","v":"href"}," and ",{"t":"code","v":"title"}," attributes?"]}],"distractors":[[{"t":"code","lang":"css","text":"a[href] a[title] { text-decoration: underline dotted; }"}],[{"t":"code","lang":"css","text":"a[href]a[title] { text-decoration: underline dotted; }"}],[{"t":"code","lang":"css","text":"a[href].[title] { text-decoration: underline dotted; }"}]],"answer":[{"t":"code","lang":"css","text":"a[href][title] { text-decoration: underline dotted; }"}]},{"text":[{"t":"p","c":["Which CSS selector would you use if you are developing a website for a restaurant and want to style all elements with the ",{"t":"code","v":"menu-item"}," class that have a ",{"t":"code","v":"data-special"}," attribute?"]}],"distractors":[[{"t":"code","lang":"css","text":"menu-item[data-special] { background-color: blue; }"}],[{"t":"code","lang":"css","text":"#menu-item[data-special] { background-color: blue; }"}],[{"t":"code","lang":"css","text":"[data-special=\"menu-item\"] { background-color: blue; }"}]],"answer":[{"t":"code","lang":"css","text":".menu-item[data-special] { background-color: blue; }"}]}]}]}]}