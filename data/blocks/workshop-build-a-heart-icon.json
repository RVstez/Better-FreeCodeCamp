idth"}," and ",{"t":"code","v":"height"}," attributes for the ",{"t":"code","v":"svg"}," element. As you are creating an icon, both values should be set small."]},{"t":"p","c":["Set both values to ",{"t":"code","v":"24"},"."]}],"hints":[{"text":[{"t":"p","c":["Your ",{"t":"code","v":"svg"}," element should have a ",{"t":"code","v":"width"}," attribute of ",{"t":"code","v":"24"},"."]}],"test":"const svg = document.querySelector('svg');\nassert.strictEqual(svg.getAttribute('width'), '24');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"svg"}," element should have a ",{"t":"code","v":"height"}," attribute of ",{"t":"code","v":"24"},"."]}],"test":"const svg = document.querySelector('svg');\nassert.strictEqual(svg.getAttribute('height'), '24');"}],"seed":{"files":[{"lang":"html","contents":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Heart Icon</title>\n  </head>\n  <body>\n    <svg>\n      <path\n        d=\"M12 21s-6-4.35-9.33-8.22C-.5 7.39 3.24 1 8.4 4.28 10.08 5.32 12 7.5 12 7.5s1.92-2.18 3.6-3.22C20.76 1 24.5 7.39 21.33 12.78 18 16.65 12 21 12 21z\"\n      ></path>\n    </svg>\n  </body>\n</html>","editable":[7,8]}]},"solutions":[],"step":4},{"id":"686daa7ed79ceacd0b264e80","title":"Step 5","dashedName":"step-5","challengeType":0,"description":[{"t":"p","c":["You are getting closer. Now, look at this example:"]},{"t":"code","lang":"html","text":"<svg viewBox=\"0 0 50 50\">\n</svg>"},{"t":"p","c":["The ",{"t":"code","v":"viewBox"}," attribute controls what part of the image is visible inside the SVG."]},{"t":"ul","items":[[{"t":"p","c":["The first two numbers (",{"t":"code","v":"0 0"},") set the starting position of the ",{"t":"code","v":"viewBox"}," — the top-left corner (x and y). "]}],[{"t":"p","c":["The next two numbers (",{"t":"code","v":"50 50"},") define the ",{"t":"code","v":"viewBox"},"'s width and height."]}]]},{"t":"p","c":["Set the ",{"t":"code","v":"viewBox"}," attribute to ",{"t":"code","v":"0 0 24 24"},"."]}],"hints":[{"text":[{"t":"p","c":["You should have a ",{"t":"code","v":"viewBox"}," attribute."]}],"test":"const svg = document.querySelector('svg');\nconst viewBox = svg.getAttribute('viewBox');\nassert.exists(viewBox);"},{"text":[{"t":"p","c":["You should set the ",{"t":"code","v":"viewBox"}," x position to 0."]}],"test":"const svg = document.querySelector('svg');\nconst viewBox = svg.getAttribute('viewBox');\nconst x = viewBox?.trim().split(' ')[0];\nassert.strictEqual(x, '0');"},{"text":[{"t":"p","c":["You should set the ",{"t":"code","v":"viewBox"}," y position to 0."]}],"test":"const svg = document.querySelector('svg');\nconst viewBox = svg.getAttribute('viewBox');\nconst y = viewBox?.trim().split(' ')[1];\nassert.strictEqual(y, '0');"},{"text":[{"t":"p","c":["You should set the ",{"t":"code","v":"viewBox"}," width to 24."]}],"test":"const svg = document.querySelector('svg');\nconst viewBox = svg.getAttribute('viewBox');\nconst width = viewBox?.trim().split(' ')[2];\nassert.strictEqual(width, '24');"},{"text":[{"t":"p","c":["You should set the ",{"t":"code","v":"viewBox"}," height to 24."]}],"test":"const svg = document.querySelector('svg');\nconst viewBox = svg.getAttribute('viewBox');\nconst height = viewBox?.trim().split(' ')[3];\nassert.strictEqual(height, '24');"}],"seed":{"files":[{"lang":"html","contents":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>Heart Icon</title>\n  </head>\n  <body>\n    <svg width=\"24\" height=\"24\">\n      <path\n        d=\"M12 21s-6-4.35-9.33-8.22C-.5 7.39 3.24 1 8.4 4.28 10.08 5.32 12 7.5 12 7.5s1.92-2.18 3.6-3.22C20.76 1 24.5 7.39 21.33 12.78 18 16.65 12 21 12 21z\"\n      ></path>\n    </svg>\n  </body>\n</html>","editable":[7,8]}]},"solutions":[],"step":5},{"id":"686daa7ed79ceacd0b264e81","title":"Step 6","dashedName":"step-6","challengeType":0,"description":[{"t":"p","c":["The heart icon is almost done. You just need to color it red. To do that, set the ",{"t":"code","v"