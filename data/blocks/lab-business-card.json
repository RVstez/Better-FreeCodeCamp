code","v":"a"}," element should have the text ",{"t":"code","v":"Twitter"},"."]}],"test":"assert.equal(document.querySelectorAll(\".social-media a\")[0]?.textContent.trim(), 'Twitter');"},{"text":[{"t":"p","c":["The ",{"t":"code","v":"href"}," of the first ",{"t":"code","v":"a"}," element should point to a valid link."]}],"test":"assert.isAbove(document.querySelectorAll('.social-media a')[0]?.getAttribute('href')?.length, 0);"},{"text":[{"t":"p","c":["The second ",{"t":"code","v":"a"}," element should have the text ",{"t":"code","v":"LinkedIn"},"."]}],"test":"\nassert.equal(document.querySelectorAll(\".social-media a\")[1]?.textContent.trim(), 'LinkedIn');"},{"text":[{"t":"p","c":["The ",{"t":"code","v":"href"}," of the second ",{"t":"code","v":"a"}," element should point to a valid link."]}],"test":"assert.isAbove(document.querySelectorAll('.social-media a')[1]?.getAttribute('href')?.length, 0);"},{"text":[{"t":"p","c":["The third ",{"t":"code","v":"a"}," element should have the text ",{"t":"code","v":"GitHub"},"."]}],"test":"assert.equal(document.querySelectorAll(\".social-media a\")[2]?.textContent.trim(), 'GitHub');"},{"text":[{"t":"p","c":["The ",{"t":"code","v":"href"}," of the third ",{"t":"code","v":"a"}," element should point to a valid link."]}],"test":"assert.isAbove(document.querySelectorAll('.social-media a')[2]?.getAttribute('href')?.length, 0);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"link"}," element should be within your ",{"t":"code","v":"head"}," element."]}],"test":"const link = document.querySelector('head > link');\nassert.isNotNull(link);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"link"}," element should have a ",{"t":"code","v":"rel"}," attribute with the value ",{"t":"code","v":"stylesheet"},"."]}],"test":"const linkRelValue = document.querySelector('link')?.getAttribute('rel');\nassert.strictEqual(linkRelValue, 'stylesheet');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"link"}," element should have an ",{"t":"code","v":"href"}," attribute with the value ",{"t":"code","v":"styles.css"},"."]}],"test":"const linkHrefValue = document.querySelector('link')?.dataset?.href;\nassert.strictEqual(linkHrefValue, 'styles.css');"},{"text":[{"t":"p","c":["You should set the page background color in the ",{"t":"code","v":"body"}," selector to ",{"t":"code","v":"rosybrown"},"."]}],"test":"assert.strictEqual(new __helpers.CSSHelp(document).getStyle('body')?.getPropVal('background-color'), 'rosybrown');"},{"text":[{"t":"p","c":["You should set the page font to ",{"t":"code","v":"Arial"}," in the ",{"t":"code","v":"body"}," element with a fallback of ",{"t":"code","v":"sans-serif"},"."]}],"test":"const el = new __helpers.CSSHelp(document).getStyle('body')?.getPropVal('font-family');\nconst condition1= el === 'Arial, sans-serif';\nconst condition2= el === '\"Arial\", sans-serif';\nassert.isTrue(condition1 || condition2);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".business-card"}," selector should have a ",{"t":"code","v":"width"}," property with a value of ",{"t":"code","v":"300px"},"."]}],"test":"assert.equal(new __helpers.CSSHelp(document).getStyle('.business-card')?.getPropVal('width'), '300px');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".business-card"}," selector should have a ",{"t":"code","v":"background-color"}," property with a valid color value."]}],"test":"assert.isNotEmpty(new __helpers.CSSHelp(document).getStyle('.business-card')?.backgroundColor);"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".business-card"}," selector should have a ",{"t":"code","v":"padding"}," property with a value of ",{"t":"code","v":"20px"},"."]}],"test":"assert.equal(new __helpers.CSSHelp(document).getStyle('.business-card')?.getPropVal('padding'), '20px');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".business-card"}," selector should have a top margin of ",{"t":"code","v":"100px"},"."]}],"test":"assert.equal(new __helpers.CSSHelp(document).getStyle('.business-card')?.getPropVal('margin-top'), '100px');"},{"text":[{"t":"p","c":["The text inside the ",{"t":"code","v":".business-card"}," element should be center-aligned."]}],"test":"assert.equal(new __helpers.CSSHelp(document).getStyle('.business-card')?.getPropVal('text-align'), 'center');"},{"text":[{"t":"p","c":["The font size of the text inside the ",{"t":"code","v":".business-card"}," element should be ",{"t":"code","v":"16px"},"."]}],"test":"assert.equal(new __helpers.CSSHelp(document).getStyle('.business-card')?.getPropVal('font-size'), '16px');"},{"text":[{"t":"p","c":["The left and right margins of the ",{"t":"code","v":".business-card"}," element should be set to ",{"t":"code","v":"auto"},"."]}],"test":"assert.equal(new __helpers.CSSHelp(document).getStyle('.business-card')?.getPropVal('margin-left'), 'auto');\nassert.equal(new __helpers.CSSHelp(document).getStyle('.business-card')?.getPropVal('margin-right'), 'auto');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":".profile-image"}," selector should have a ",{"t":"code","v":"max-width"}," property with a value of ",{"t":"code","v":"100%"},"."]}],"test":"assert.equal(new __helpers.CSSHelp(document).getStyle('.profile-image')?.getPropVal('max-width'), '100%');"},{"text":[{"t":"p","c":["Your ",{"t":"code","v":"p"}," elements should have a top and bottom ",{"t":"code","v":"margin"}," of ",{"t":"code","v":"5px"},"."]}],"test":"const marginTop = new __helpers.CSSHelp(document).getStyle('p')?.getPropVal('margin-top');\nconst marginBottom = new __helpers.CSSHelp(document).getStyle('p')?.getPropVal('margin-bottom');\n\nassert.equal(marginTop, '5px');\nassert.equal(marginBottom, '5px');"},{"text":[{"t":"p","c":["The links of the page should have no underline."]}],"test":"assert.equal(new __helpers.CSSHelp(document).getStyle('a')?.getPropVal('text-decoration'), 'none');"}],"seed":{"files":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"utf-8\">\n  <title>Business Card</title>\n</head>\n\n<body>\n\n</body>\n\n</html>"},{"lang":"css","contents":""}]},"solutions":[{"lang":"html","contents":"<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Digital Business Card</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n\n<body>\n  <div class=\"business-card\">\n    <img src=\"https://cdn.freecodecamp.org/curriculum/labs/flower.jpg\" alt=\"A vibrant flower in full bloom\" class=\"profile-image\">\n    <p class=\"full-name\">Your Name</p>\n    <p class=\"designation\">Software Developer</p>\n    <p class=\"company\" >@freeCodeCamp</p>\n    <hr>\n    <p>Email: your-email@example.com</p>\n    <p>Phone: (123) 456-7890</p>\n    <a class=\"portfolio-link\" href=\"http://example.com\">Portfolio</a>\n    <hr>\n    <div class=\"social-media\">\n      <h2>Connect with me</h2>\n      <a href=\"http://twitter.com/\">Twitter</a>\n      <a href=\"http://linkedin.com/\">LinkedIn</a>\n      <a href=\"http://github.com/\">GitHub</a>\n    </div>\n  </div>\n</body>\n\n</html>\n"},{"lang":"css","contents":"body {\n  background-color: rosybrown;\n  font-family: \"Arial\", sans-serif;\n}\n\n.business-card {\n  background-color: lavenderblush;\n  border: 3px solid darkslategray;\n  padding: 20px;\n  text-align: center;\n  font-size: 16px;\n  width: 300px;\n  margin-left: auto;\n  margin-right: auto;\n  margin-top: 100px;\n}\n\n.profile-image {\n  max-width: 100%;\n  width: 150px;\n  height: 150px;\n  margin-bottom: 10px;\n  border: 2px solid lightgray;\n}\n\n.full-name {\n  font-size: 24px;\n  color: darkslategray;\n}\n\n.designation {\n  font-size: 18px;\n  color: gray;\n}\n\n.company {\n  font-size: 16px;\n  color: darkgray;\n}\n\np {\n  margin: 5px 0;\n}\n\na {\n  text-decoration: none;\n}\n\n.social-media {\n  margin-top: 10px;\n  font-size: 14px;\n}\n\n.social-media a {\n  margin: 10px;\n  color: maroon\n}\n\nhr {\n  margin: 20px 0;\n}"}]}]}